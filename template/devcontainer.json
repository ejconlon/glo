{
  "name": "__PROJECT_NAME__",
  "build": {
    "dockerfile": "image/Dockerfile",
    "context": "image",
    "args": {
      "PROJECT_NAME": "__PROJECT_NAME__",
      "CADDY_ENABLED": "0",
      "POSTGRES_ENABLED": "0",
      "GARAGE_ENABLED": "0"
    }
  },
  "remoteUser": "user",
  "runArgs": ["-p", "127.0.0.1::4096"],
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": {
      "label": "opencode",
      "onAutoForward": "silent"
    }
  },
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/user/.claude",
    "CODEX_HOME": "/home/user/.codex"
  },
  "mounts": [
    "source=${localWorkspaceFolder}/.git,target=/workspaces/__PROJECT_NAME__/.git,type=bind,readonly",
    "source=__PROJECT_NAME__-glo-0,target=/workspaces/__PROJECT_NAME__/.glo,type=volume",
    "source=__PROJECT_NAME__-xdg-config-0,target=/home/user/.config,type=volume",
    "source=__PROJECT_NAME__-xdg-share-0,target=/home/user/.local/share,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/user/.claude,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/user/.codex,type=bind",
    "source=${localEnv:HOME}/.gemini,target=/home/user/.gemini,type=bind",
    "source=${localEnv:HOME}/.config/opencode,target=/home/user/.config/opencode,type=bind"
  ]
}
