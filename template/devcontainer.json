{
  "name": "__PROJECT_NAME__",
  "build": {
    "dockerfile": "image/Dockerfile",
    "context": "image",
    "args": {
      "PROJECT_NAME": "__PROJECT_NAME__"
    }
  },
  "remoteUser": "user",
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/user/.claude",
    "CODEX_HOME": "/home/user/.codex"
  },
  "mounts": [
    "source=__PROJECT_NAME__-glo-0,target=/workspaces/__PROJECT_NAME__/.glo,type=volume",
    "source=__PROJECT_NAME__-claude-home-0,target=/home/user/.claude,type=volume",
    "source=__PROJECT_NAME__-codex-home-0,target=/home/user/.codex,type=volume",
    "source=__PROJECT_NAME__-gemini-home-0,target=/home/user/.gemini,type=volume",
    "source=__PROJECT_NAME__-opencode-home-0,target=/home/user/.local/share/opencode,type=volume"
  ]
}
