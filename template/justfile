set positional-arguments

glo := "__GLO__"

default:
    @just --list

# Build the workspace devcontainer image
image:
    just -f {{glo}}/devcontainer/justfile --set workspace "$PWD" image

shell *args:
    #!/bin/bash
    just -f {{glo}}/devcontainer/justfile --set workspace "$PWD" shell "$@"

opencode *args:
    #!/bin/bash
    just -f {{glo}}/devcontainer/justfile --set workspace "$PWD" opencode "$@"

precommit:
    bin/glo-build --filter=work precommit
    bin/glo-notes precommit
