cabal-version: 3.0
name:          {{cookiecutter.name | replace("_", "-")}}
version:       {{cookiecutter.version}}
synopsis:      {{cookiecutter.description}}

library
  exposed-modules: Lib
  hs-source-dirs:  src
  default-language: GHC2021
  build-depends:   base ^>=4.21

test-suite test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  default-language: GHC2021
  build-depends:
      base ^>=4.21
    , {{cookiecutter.name | replace("_", "-")}}
