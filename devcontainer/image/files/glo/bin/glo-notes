#!/usr/bin/env bash
set -euo pipefail

_GLO_BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

_find_workspace() {
    local d="$PWD"
    while [[ "$d" != "/" ]]; do
        [[ -d "$d/.git" ]] && { echo "$d"; return 0; }
        d="$(dirname "$d")"
    done
    echo "[E] No .git directory found from $PWD upward" >&2
    return 1
}

WORKSPACE_DIR="$(_find_workspace)"
# shellcheck source=../lib/paths.sh
source "${_GLO_BIN_DIR}/../lib/paths.sh"
BASE_DIR="$(glo_base_dir "$WORKSPACE_DIR")"
ZK_DB="${BASE_DIR}/.zk/notebook.db"

_gen_titles() {
    local output_file="$1"
    local path_filter="${2:-}"
    local where_clause="WHERE title != '' AND path NOT LIKE '%/archive/%'"
    if [[ -n "$path_filter" ]]; then
        where_clause="$where_clause AND path LIKE '${path_filter}%'"
    fi
    sqlite3 "$ZK_DB" <<SQL > "$output_file"
.mode list
SELECT '# Note Titles Index

All notes sorted alphabetically by title.' ||
       COALESCE(char(10) || char(10) || group_concat(link, char(10)), '')
FROM (
    SELECT '- [' || title || '](' || path || ')' AS link
    FROM notes
    ${where_clause}
    ORDER BY title COLLATE NOCASE
);
SQL
}

_gen_tags() {
    local output_file="$1"
    local path_filter="${2:-}"
    python3 - "$ZK_DB" "$path_filter" <<'PYEOF' > "$output_file"
import sqlite3
import sys

conn = sqlite3.connect(sys.argv[1])
cursor = conn.cursor()
rows = cursor.execute("""
    SELECT c.name as tag, n.title, n.path
    FROM collections c
    JOIN notes_collections nc ON c.id = nc.collection_id
    JOIN notes n ON nc.note_id = n.id
    WHERE c.kind = 'tag'
      AND n.path NOT LIKE '%/archive/%'
      AND n.path LIKE ?
    ORDER BY c.name, n.title COLLATE NOCASE
""", (sys.argv[2] + '%',)).fetchall()
lines = ["# Tags Index", "", "All notes organized by tags."]
current_tag = None
for row in rows:
    tag, title, path = row
    if tag != current_tag:
        lines.extend(["", f"## {tag}", ""])
        current_tag = tag
    lines.append(f"- [{title}]({path})")
print("\n".join(lines))
conn.close()
PYEOF
}

cmd_index() {
    [[ -d "${BASE_DIR}/.zk" ]] || { echo "[E] Notebook config not found: ${BASE_DIR}/.zk - run bootstrap.sh first" >&2; exit 1; }
    echo "[I] Indexing notes..."
    ZK_NOTEBOOK_DIR="$BASE_DIR" zk index --quiet
    local subdir subdir_path
    for subdir in issue wiki; do
        subdir_path="${BASE_DIR}/${subdir}"
        if [[ -d "$subdir_path" ]]; then
            echo "[I] Generating indices for ${subdir}/"
            _gen_titles "${subdir_path}/TITLES.md" "${subdir}/"
            _gen_tags "${subdir_path}/TAGS.md" "${subdir}/"
        fi
    done
    _gen_titles "${BASE_DIR}/TITLES.md"
    _gen_tags "${BASE_DIR}/TAGS.md"
    echo "[I] Done"
}

# Let glo-issue select and move issues so archive rules have one implementation.
cmd_precommit() {
    [[ -d "${BASE_DIR}/.zk" ]] || { echo "[E] Notebook config not found: ${BASE_DIR}/.zk - run bootstrap.sh first" >&2; exit 1; }
    local -x TICKETS_DIR="${BASE_DIR}/issue"
    local listing id status _remainder count=0
    if [[ -d "$TICKETS_DIR" ]]; then
        echo "[I] Checking for closed or iceboxed issues to archive..."
        listing=$("${_GLO_BIN_DIR}/glo-issue" ls) || return 1
        while read -r id status _remainder; do
            [[ -n "$id" ]] || continue
            if [[ "$status" == "[closed]" || "$status" == "[icebox]" ]]; then
                "${_GLO_BIN_DIR}/glo-issue" archive "$id" || return 1
                count=$((count + 1))
            fi
        done <<< "$listing"
        [[ $count -gt 0 ]] && echo "[I] Archived $count closed or iceboxed issue(s)"

        echo "[I] Checking for resumed issues in archive..."
        listing=$("${_GLO_BIN_DIR}/glo-issue" ls --only-archived) || return 1
        count=0
        while read -r id status _remainder; do
            [[ -n "$id" ]] || continue
            if [[ "$status" != "[closed]" && "$status" != "[icebox]" ]]; then
                "${_GLO_BIN_DIR}/glo-issue" unarchive "$id" || return 1
                count=$((count + 1))
            fi
        done <<< "$listing"
        [[ $count -gt 0 ]] && echo "[I] Unarchived $count issue(s)"
    fi
    cmd_index
}

usage() {
    cat <<'EOF'
glo-notes - zk notebook wrapper for the selected Glo base

Usage: glo-notes index
       glo-notes precommit
       glo-notes zk <subcommand> [arguments...]

Commands:
  index       Update zk index and regenerate TITLES.md / TAGS.md
  precommit   Reconcile archives through glo-issue, then run index
  zk          Pass remaining arguments to zk in the selected notebook
  help        Show this reference (also -h, --help)

Examples:
  glo-notes zk list --tag peal
  glo-notes zk new --group wiki --title "Project notes"
  glo-notes zk --help

Only the explicit zk command passes arguments through; unknown commands fail.

Environment:
  GLO_BASE    Notebook root [default: base]; relative to the workspace root
              or an absolute path. Empty values also use the default.
              Glo sets ZK_NOTEBOOK_DIR to this resolved path.
EOF
}

case "${1:-help}" in
    index|precommit)
        if [[ $# -ne 1 ]]; then
            echo "Error: $1 does not accept arguments; use 'glo-notes zk' for zk options" >&2
            exit 1
        fi
        "cmd_$1"
        ;;
    zk) shift; exec env ZK_NOTEBOOK_DIR="$BASE_DIR" zk "$@" ;;
    help|--help|-h) usage ;;
    *)
        echo "Error: unknown glo-notes command '$1'; use 'glo-notes zk $1' for zk" >&2
        usage >&2
        exit 1
        ;;
esac
