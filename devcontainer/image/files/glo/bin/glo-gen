#!/usr/bin/env bash
set -euo pipefail

_find_workspace() {
    local d="$PWD"
    while [[ "$d" != "/" ]]; do
        [[ -d "$d/.git" ]] && { echo "$d"; return 0; }
        d="$(dirname "$d")"
    done
    echo "[E] No .git directory found from $PWD upward" >&2
    return 1
}
_GLO_BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
TEMPLATES_DIR="${_GLO_BIN_DIR}/../templates"

_types=()
for _t in "${TEMPLATES_DIR}"/*/; do
    [[ -d "$_t" ]] && _types+=("$(basename "$_t")")
done

usage() {
    if [[ "${1:-stdout}" == "stderr" ]]; then
        {
            echo "glo-gen - generate a lib component from a template"
            echo ""
            echo "Usage: glo-gen TEMPLATE_NAME SUBPROJECT_NAME"
            echo ""
            echo "Templates: ${_types[*]}"
            echo ""
            echo "Output goes to lib/ in the workspace root."
        } >&2
    else
        echo "glo-gen - generate a lib component from a template"
        echo ""
        echo "Usage: glo-gen TEMPLATE_NAME SUBPROJECT_NAME"
        echo ""
        echo "Templates: ${_types[*]}"
        echo ""
        echo "Output goes to lib/ in the workspace root."
    fi
}

if [[ $# -eq 1 && ("$1" == "--help" || "$1" == "-h") ]]; then
    usage
    exit 0
fi

if [[ $# -ne 2 ]]; then
    usage stderr
    exit 1
fi

WORKSPACE_DIR="$(_find_workspace)"

if [[ -x "${WORKSPACE_DIR}/.glo/build/bin/cookiecutter" ]]; then
    COOKIECUTTER="${WORKSPACE_DIR}/.glo/build/bin/cookiecutter"
elif [[ -x "/opt/glo/.venv/bin/cookiecutter" ]]; then
    COOKIECUTTER="/opt/glo/.venv/bin/cookiecutter"
elif [[ "$_GLO_BIN_DIR" == "/opt/glo/bin" ]]; then
    COOKIECUTTER="/opt/glo/.venv/bin/cookiecutter"
else
    COOKIECUTTER="${WORKSPACE_DIR}/.glo/build/bin/cookiecutter"
fi

TYPE="$1"
SUBPROJECT_NAME="$2"
TEMPLATE="${TEMPLATES_DIR}/${TYPE}"

if [[ ! -d "$TEMPLATE" ]]; then
    echo "[E] Unknown template '${TYPE}'. Available: ${_types[*]}" >&2
    exit 1
fi

exec "$COOKIECUTTER" "$TEMPLATE" --output-dir "${WORKSPACE_DIR}/lib" --no-input "name=${SUBPROJECT_NAME}"
