#!/usr/bin/env python3
"""Manage a SecretSpec KDBX database whose password lives in a system keychain."""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path
from typing import NoReturn, Sequence


class SecretsCommandError(RuntimeError):
    """The local KDBX command is incomplete or cannot be executed."""


def _parser(environment: dict[str, str] | None = None) -> argparse.ArgumentParser:
    values = os.environ if environment is None else environment
    parser = argparse.ArgumentParser(prog="glo-secrets")
    parser.add_argument(
        "--provider",
        default=values.get("GLO_SECRETS_PROVIDER"),
        help="User-level KDBX provider alias (or GLO_SECRETS_PROVIDER).",
    )
    commands = parser.add_subparsers(dest="command", required=True)

    initialize = commands.add_parser(
        "init", help="Configure KDBX and store its master password in the keychain."
    )
    _add_provider_override(initialize)
    initialize.add_argument(
        "--database",
        type=Path,
        default=values.get("GLO_SECRETS_DATABASE"),
        help="KDBX path (or GLO_SECRETS_DATABASE).",
    )
    initialize.add_argument("--file", type=Path, required=True)

    put = commands.add_parser("put", help="Prompt for and store one declared value.")
    _add_provider_override(put)
    _add_manifest_selection(put, scope=False)
    put.add_argument("name")

    delete = commands.add_parser("delete", help="Delete declared values.")
    _add_provider_override(delete)
    _add_manifest_selection(delete, scope=False)
    delete.add_argument("names", nargs="+")

    import_values = commands.add_parser(
        "import", help="Import declared values from another SecretSpec provider."
    )
    _add_provider_override(import_values)
    _add_manifest_selection(import_values, scope=False)
    import_values.add_argument("from_provider")

    check = commands.add_parser(
        "check", help="Check one declared scope without values."
    )
    _add_provider_override(check)
    _add_manifest_selection(check, scope=True)
    check.add_argument("--explain", action="store_true")

    run = commands.add_parser(
        "run", help="Run a command with the selected scope materialized by SecretSpec."
    )
    _add_provider_override(run)
    _add_manifest_selection(run, scope=True)
    run.add_argument("argv", nargs=argparse.REMAINDER)

    build = commands.add_parser(
        "build", help="Run glo-build with the selected provider and manifest."
    )
    _add_provider_override(build)
    build.add_argument(
        "build_args",
        nargs=argparse.REMAINDER,
        help="Arguments forwarded unchanged to glo-build.",
    )
    return parser


def _add_manifest_selection(parser: argparse.ArgumentParser, *, scope: bool) -> None:
    parser.add_argument("--file", type=Path, required=True)
    if scope:
        parser.add_argument("--scope", required=True)


def _add_provider_override(parser: argparse.ArgumentParser) -> None:
    parser.add_argument(
        "--provider",
        default=argparse.SUPPRESS,
        help="Override the user-level KDBX provider alias for this operation.",
    )


def main(
    argv: Sequence[str] | None = None,
    *,
    environment: dict[str, str] | None = None,
) -> int:
    """Parse one KDBX operation and delegate it to SecretSpec."""
    runtime_environment = dict(os.environ if environment is None else environment)
    runtime_environment.pop("SECRETSPEC_PROFILE", None)
    arguments = _parser(runtime_environment).parse_args(argv)
    try:
        provider = _provider_alias(arguments.provider)
        if arguments.command == "build":
            _build(provider, arguments, runtime_environment)
        binary = _secretspec_binary(runtime_environment)
        if arguments.command == "init":
            _initialize(binary, provider, arguments)
            return 0
        runtime_environment["SECRETSPEC_PROFILE"] = "secret"
        command = _manifest_command(binary, provider, arguments)
        if arguments.command == "import":
            runtime_environment["SECRETSPEC_PROVIDER"] = provider
        result = subprocess.run(command, check=False, env=runtime_environment)
        return _returncode(result.returncode)
    except SecretsCommandError as error:
        print(f"glo-secrets: {error}", file=sys.stderr)
        return 2


def _provider_alias(value: str | None) -> str:
    if value is None or not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", value):
        raise SecretsCommandError(
            "a user-level provider alias is required with --provider or "
            "GLO_SECRETS_PROVIDER"
        )
    return value


def _secretspec_binary(environment: dict[str, str]) -> str:
    configured = environment.get("SECRETSPEC")
    if configured:
        path = Path(configured).expanduser()
        if path.is_file() and os.access(path, os.X_OK):
            return str(path)
        raise SecretsCommandError("SECRETSPEC does not name an executable")
    binary = shutil.which("secretspec", path=environment.get("PATH"))
    if binary is None:
        raise SecretsCommandError(
            "SecretSpec is unavailable; install it with 'glo local secretspec'"
        )
    return binary


def _initialize(binary: str, provider: str, arguments: argparse.Namespace) -> None:
    database = arguments.database
    if database is None:
        raise SecretsCommandError(
            "a database path is required with --database or GLO_SECRETS_DATABASE"
        )
    database = database.expanduser().resolve(strict=False)
    if database.suffix != ".kdbx":
        raise SecretsCommandError("the database path must end in .kdbx")
    database.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    uri = f"kdbx:{database}"
    credential_source = f"keyring://glo-secrets/{provider}/{{key}}"
    add = [
        binary,
        "config",
        "global",
        "provider",
        "add",
        provider,
        uri,
        "--credential",
        f"password={credential_source}",
    ]
    login = [
        binary,
        "--file",
        str(arguments.file),
        "config",
        "provider",
        "login",
        provider,
    ]
    _run_required(add, "could not configure the KDBX provider")
    _run_required(login, "could not store the KDBX password in the system keychain")
    print(
        f"KDBX provider '{provider}' is ready; the database will be created on first put."
    )


def _run_required(command: list[str], message: str) -> None:
    try:
        subprocess.run(command, check=True)
    except (OSError, subprocess.CalledProcessError):
        raise SecretsCommandError(message) from None


def _manifest_command(
    binary: str, provider: str, arguments: argparse.Namespace
) -> list[str]:
    common = [
        binary,
        "--file",
        str(arguments.file),
    ]
    selection = ["--provider", provider]
    if arguments.command == "put":
        return [*common, "set", *selection, arguments.name]
    if arguments.command == "delete":
        return [*common, "delete", *selection, *arguments.names]
    if arguments.command == "import":
        return [*common, "import", arguments.from_provider]
    if arguments.command == "check":
        report = "--explain" if arguments.explain else "--json"
        return [
            *common,
            "check",
            *selection,
            "--scope",
            arguments.scope,
            report,
        ]
    if arguments.command == "run":
        command = list(arguments.argv)
        if command[:1] == ["--"]:
            command = command[1:]
        if not command:
            raise SecretsCommandError("run requires a command after --")
        return [
            *common,
            "run",
            *selection,
            "--scope",
            arguments.scope,
            "--",
            *command,
        ]
    raise SecretsCommandError("unsupported operation")


def _build(
    provider: str,
    arguments: argparse.Namespace,
    environment: dict[str, str],
) -> NoReturn:
    build_arguments = list(arguments.build_args)
    if build_arguments[:1] == ["--"]:
        build_arguments = build_arguments[1:]
    if not build_arguments:
        raise SecretsCommandError("build requires one /lib project")
    manifest = _validate_project_selector(build_arguments, _workspace_root())
    build = Path(__file__).resolve().with_name("glo-build")
    if not build.is_file() or not os.access(build, os.X_OK):
        raise SecretsCommandError("glo-build is unavailable")
    command = [str(build), *build_arguments]
    environment["SECRETSPEC_PROVIDER"] = provider
    environment["SECRETSPEC_FILE"] = str(manifest)
    environment.pop("SECRETSPEC_PROFILE", None)
    environment.pop("SECRETSPEC_SCOPE", None)
    try:
        os.execve(command[0], command, environment)
    except OSError:
        raise SecretsCommandError("glo-build could not be executed") from None


def _workspace_root() -> Path:
    """Find the workspace using the same .git-directory boundary as glo-build."""
    current = Path.cwd().resolve()
    for candidate in (current, *current.parents):
        if (candidate / ".git").is_dir():
            return candidate
    raise SecretsCommandError("no workspace was found from the current directory")


def _validate_project_selector(arguments: list[str], workspace: Path) -> Path:
    """Require one concrete /lib project and return its SecretSpec manifest."""
    selector = arguments[0]
    parts = selector.split("/")
    if (
        len(parts) < 3
        or parts[:2] != ["", "lib"]
        or any(part in {"", ".", ".."} for part in parts[2:])
    ):
        raise SecretsCommandError(
            "build project must be a concrete selector beginning with /lib/"
        )
    build_file = workspace.joinpath(*parts[1:], "build.json")
    if not build_file.is_file():
        raise SecretsCommandError(f"build project has no build.json: {selector}")
    manifest = build_file.with_name("secretspec.toml")
    if not manifest.is_file():
        raise SecretsCommandError(f"build project has no secretspec.toml: {selector}")
    for argument in arguments[1:]:
        if argument == "--":
            break
        if argument.startswith(("/", "^/")):
            raise SecretsCommandError("build accepts exactly one project selector")
    return manifest


def _returncode(returncode: int) -> int:
    return 128 - returncode if returncode < 0 else returncode


if __name__ == "__main__":
    raise SystemExit(main())
