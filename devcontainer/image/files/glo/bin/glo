#!/usr/bin/env bash
set -euo pipefail

_GLO_BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
README="${_GLO_BIN_DIR}/../README.md"

case "${1:-}" in
    issue)     shift; exec "${_GLO_BIN_DIR}/glo-issue" "$@" ;;
    agent)     shift; exec "${_GLO_BIN_DIR}/glo-agent" "$@" ;;
    build)     shift; GLO_BUILD_CMD="glo build" exec "${_GLO_BIN_DIR}/glo-build" "$@" ;;
    caddy)     shift; exec "${_GLO_BIN_DIR}/glo-caddy" "$@" ;;
    gen)       shift; exec "${_GLO_BIN_DIR}/glo-gen" "$@" ;;
    garage)    shift; exec "${_GLO_BIN_DIR}/glo-garage" "$@" ;;
    local)     shift; exec "${_GLO_BIN_DIR}/glo-local" "$@" ;;
    notes)     shift; exec "${_GLO_BIN_DIR}/glo-notes" "$@" ;;
    postgres)  shift; exec "${_GLO_BIN_DIR}/glo-postgres" "$@" ;;
    secrets)   shift; exec "${_GLO_BIN_DIR}/glo-secrets" "$@" ;;
    readme)    cat "$README" ;;
    help|--help|-h)
        cat <<EOF
glo - developer tools dispatcher

Usage: glo <command> [args]

Commands:
  issue      Ticket system (glo-issue --help)
  agent      Agent-aware issue CLI with focus stack (glo-agent --help)
  build      Lightweight build system (glo-build --help)
  caddy      Run the optional Caddy HTTPS edge
  gen        Generate a lib component from a template (glo-gen --help)
  garage     Run the optional Garage development object store
  local      Install host dependencies (glo-local --help)
  notes      zk notebook wrapper for base/ (glo-notes --help)
  postgres   Disposable PostgreSQL 18 test cluster (when enabled)
  secrets    Manage a local KDBX database through SecretSpec
  readme     Print full documentation
EOF
        ;;
    *)
        echo "Usage: glo {issue|agent|build|caddy|gen|garage|local|notes|postgres|secrets|readme} [args]" >&2
        echo "Run 'glo help' for documentation." >&2
        exit 1
        ;;
esac
