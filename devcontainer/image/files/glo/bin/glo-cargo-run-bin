#!/usr/bin/env bash
set -euo pipefail

tool="${1:-}"
if [[ -z "$tool" ]]; then
    echo "usage: glo-cargo-run-bin <tool> [args...]" >&2
    exit 2
fi
shift

if [[ -z "${RS_VENV:-}" ]]; then
    echo "RS_VENV is required" >&2
    exit 2
fi

mkdir -p "${RS_VENV}/bin"
dest="${RS_VENV}/bin/${tool}"

cleanup() {
    rm -rf "${RS_VENV}/.bin" "${RS_VENV}/Cargo.toml" "${RS_VENV}/Cargo.lock"
}

if [[ ! -x "$dest" ]]; then
    exec 9>"${RS_VENV}/bin/.lock"
    flock 9
    trap cleanup EXIT

    if [[ ! -x "$dest" ]]; then
        cleanup
        cp Cargo.toml Cargo.lock "${RS_VENV}/"
        (cd "${RS_VENV}" && cargo bin --install)
        src="$(find "${RS_VENV}/.bin" -path "*/bin/${tool}" -type f -perm -u+x | sort | tail -n 1)"
        if [[ -z "$src" ]]; then
            echo "cargo bin did not install ${tool}" >&2
            exit 1
        fi
        install -m 755 "$src" "$dest"
        cleanup
    fi

    trap - EXIT
fi

exec "$dest" "$@"
