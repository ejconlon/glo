#!/usr/bin/env bash
set -euo pipefail

tool="${1:-}"
if [[ -z "$tool" ]]; then
    echo "usage: glo-cargo-run-bin <tool> [args...]" >&2
    exit 2
fi
shift

if [[ -z "${RS_VENV:-}" ]]; then
    echo "RS_VENV is required" >&2
    exit 2
fi

dest="${RS_VENV}/.bin/${tool}"

if [[ ! -x "$dest" ]]; then
    cp Cargo.toml Cargo.lock "${RS_VENV}/"
    (cd "${RS_VENV}" && cargo bin --install)
fi

# cargo-run-bin >=0.4 installs to versioned subdirs (.bin/<rust>/<tool>/<ver>/bin/<tool>)
if [[ ! -x "$dest" ]]; then
    for candidate in "${RS_VENV}/.bin"/*/"${tool}"/*/bin/"${tool}"; do
        if [[ -x "$candidate" ]]; then
            dest="$candidate"
            break
        fi
    done
fi

if [[ ! -x "$dest" ]]; then
    echo "${tool} was not installed under ${RS_VENV}/.bin" >&2
    exit 1
fi

exec "$dest" "$@"
