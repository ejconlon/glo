#!/usr/bin/env bash
set -euo pipefail

postgres_bin=/usr/pgsql-18/bin
postgres_user=glo
postgres_password=glo
postgres_database=glo_test
postgres_port="${GLO_POSTGRES_PORT:-55432}"
postgres_root="${GLO_POSTGRES_ROOT:-${XDG_STATE_HOME:-${HOME}/.local/state}/glo/postgres-18}"
postgres_data="${postgres_root}/data"
postgres_socket="${postgres_root}/socket"
postgres_log="${postgres_root}/postgres.log"
postgres_listen_host="${GLO_POSTGRES_LISTEN_HOST:-127.0.0.1}"
postgres_host_cidr="${GLO_POSTGRES_HOST_CIDR:-}"
container_mode=0
container_state_root=/var/lib/glo-postgres

usage() {
    cat <<'EOF'
Usage: glo-postgres [--container] {run|start|stop|status|url|env}

Manage the disposable loopback-only PostgreSQL 18 cluster included when the
devcontainer is built with POSTGRES_ENABLED=1. Use --container on a host without
PostgreSQL 18 to run the cluster from that devcontainer image.

Environment:
  GLO_CONTAINER_ENGINE           Host engine (default: Docker on macOS, Podman otherwise)
  GLO_POSTGRES_PORT              Loopback TCP port (default: 55432)
  GLO_POSTGRES_ROOT              Persistent cluster state directory
  GLO_POSTGRES_CONTAINER_IMAGE   Enabled image (default: devcontainer-WORKSPACE)
  GLO_POSTGRES_CONTAINER_NAME    Container name override
EOF
}

fail() {
    printf '[E] %s\n' "$*" >&2
    exit 1
}

if [[ "${1:-}" == "--container" ]]; then
    container_mode=1
    shift
fi

command_name="${1:-}"
case "$command_name" in
    help|--help|-h) usage; exit 0 ;;
esac

validate_config() {
    [[ "$postgres_port" =~ ^[0-9]+$ ]] || fail "GLO_POSTGRES_PORT must be numeric"
    ((postgres_port >= 1024 && postgres_port <= 65535)) \
        || fail "GLO_POSTGRES_PORT must be between 1024 and 65535"
    [[ -n "$postgres_root" && "$postgres_root" != "/" ]] \
        || fail "GLO_POSTGRES_ROOT must select a non-root directory"
    [[ "$postgres_root" == /* ]] \
        || fail "GLO_POSTGRES_ROOT must be an absolute path"
    [[ "$postgres_listen_host" == "127.0.0.1" \
        || "$postgres_listen_host" == "0.0.0.0" ]] \
        || fail "GLO_POSTGRES_LISTEN_HOST must select a supported address"
    [[ -z "$postgres_host_cidr" || "$postgres_host_cidr" == "0.0.0.0/0" ]] \
        || fail "GLO_POSTGRES_HOST_CIDR must select a supported network"
}

database_url() {
    printf 'postgresql://%s:%s@127.0.0.1:%s/%s?sslmode=disable\n' \
        "$postgres_user" "$postgres_password" "$postgres_port" "$postgres_database"
}

require_feature() {
    if [[ ! -x "${postgres_bin}/postgres" ]]; then
        fail "PostgreSQL 18 is unavailable; rebuild with POSTGRES_ENABLED=1 or use --container"
    fi
}

is_running() {
    [[ -f "${postgres_data}/PG_VERSION" ]] \
        && "${postgres_bin}/pg_ctl" --pgdata="$postgres_data" status >/dev/null 2>&1
}

initialize_cluster() {
    if [[ -f "${postgres_data}/PG_VERSION" ]]; then
        return
    fi
    mkdir -p "$postgres_root" "$postgres_socket"
    chmod 700 "$postgres_root" "$postgres_socket"
    password_file="$(mktemp "${postgres_root}/password.XXXXXX")"
    trap 'rm -f "$password_file"' RETURN
    chmod 600 "$password_file"
    printf '%s\n' "$postgres_password" > "$password_file"
    "${postgres_bin}/initdb" \
        --pgdata="$postgres_data" \
        --username="$postgres_user" \
        --pwfile="$password_file" \
        --auth-local=trust \
        --auth-host=scram-sha-256 \
        --encoding=UTF8 \
        --locale=C.UTF-8 >/dev/null
    rm -f "$password_file"
    trap - RETURN
}

configure_host_authentication() {
    if [[ -z "$postgres_host_cidr" ]]; then
        return
    fi
    authentication_rule="host all all ${postgres_host_cidr} scram-sha-256"
    if ! grep -Fxq "$authentication_rule" "${postgres_data}/pg_hba.conf"; then
        printf '%s\n' "$authentication_rule" >> "${postgres_data}/pg_hba.conf"
    fi
}

start_cluster() {
    initialize_cluster
    configure_host_authentication
    mkdir -p "$postgres_socket"
    chmod 700 "$postgres_socket"
    if ! is_running; then
        "${postgres_bin}/pg_ctl" \
            --pgdata="$postgres_data" \
            --log="$postgres_log" \
            --options="-h ${postgres_listen_host} -p ${postgres_port} -k ${postgres_socket}" \
            --wait start >/dev/null
    fi
    if ! PGPASSWORD="$postgres_password" "${postgres_bin}/psql" \
        --host=127.0.0.1 \
        --port="$postgres_port" \
        --username="$postgres_user" \
        --dbname=postgres \
        --tuples-only \
        --no-align \
        --command="SELECT 1 FROM pg_database WHERE datname = '${postgres_database}'" \
        | grep -qx 1; then
        PGPASSWORD="$postgres_password" "${postgres_bin}/createdb" \
            --host=127.0.0.1 \
            --port="$postgres_port" \
            --username="$postgres_user" \
            "$postgres_database"
    fi
    printf 'PostgreSQL 18 ready at %s\n' "$(database_url)"
}

run_cluster() {
    start_cluster
    "${postgres_bin}/pg_ctl" \
        --pgdata="$postgres_data" \
        --wait \
        --mode=fast stop >/dev/null
    exec "${postgres_bin}/postgres" \
        -D "$postgres_data" \
        -h "$postgres_listen_host" \
        -p "$postgres_port" \
        -k "$postgres_socket"
}

stop_cluster() {
    if is_running; then
        "${postgres_bin}/pg_ctl" \
            --pgdata="$postgres_data" \
            --wait \
            --mode=fast stop >/dev/null
        printf 'PostgreSQL 18 stopped\n'
    else
        printf 'PostgreSQL 18 is not running\n'
    fi
}

workspace_root() {
    candidate="$PWD"
    while [[ "$candidate" != "/" ]]; do
        if [[ -e "${candidate}/.git" ]]; then
            printf '%s\n' "$candidate"
            return
        fi
        candidate="$(dirname "$candidate")"
    done
    fail "--container must run beneath a workspace containing .git"
}

configure_container() {
    case "$(uname -s)" in
        Darwin) default_container_engine="docker" ;;
        *) default_container_engine="podman" ;;
    esac
    container_engine="${GLO_CONTAINER_ENGINE:-${default_container_engine}}"
    case "$container_engine" in
        docker|podman) ;;
        *) fail "GLO_CONTAINER_ENGINE must be 'podman' or 'docker'" ;;
    esac
    command -v "$container_engine" >/dev/null 2>&1 \
        || fail "Container engine not found: ${container_engine}"
    workspace="$(workspace_root)"
    workspace_name="$(basename "$workspace")"
    container_image="${GLO_POSTGRES_CONTAINER_IMAGE:-devcontainer-${workspace_name}}"
    container_name="${GLO_POSTGRES_CONTAINER_NAME:-glo-postgres-${workspace_name}-${postgres_port}}"
    helper_path="$(realpath "${BASH_SOURCE[0]}")"
    [[ -n "$container_image" ]] || fail "GLO_POSTGRES_CONTAINER_IMAGE must not be empty"
    [[ "$container_name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] \
        || fail "GLO_POSTGRES_CONTAINER_NAME is invalid"
}

container_exists() {
    "$container_engine" container inspect "$container_name" >/dev/null 2>&1
}

container_is_running() {
    [[ "$("$container_engine" container inspect --format '{{.State.Running}}' "$container_name" 2>/dev/null)" \
        == "true" ]]
}

container_postgres_is_ready() {
    container_is_running \
        && "$container_engine" exec --env "PGPASSWORD=${postgres_password}" "$container_name" \
            "${postgres_bin}/psql" \
            --host=127.0.0.1 \
            --port="$postgres_port" \
            --username="$postgres_user" \
            --dbname="$postgres_database" \
            --tuples-only \
            --no-align \
            --command='SELECT 1' 2>/dev/null \
        | grep -qx 1
}

require_owned_container() {
    owner="$("$container_engine" container inspect \
        --format '{{index .Config.Labels "dev.glo.postgres"}}' \
        "$container_name" 2>/dev/null)"
    owner_workspace="$("$container_engine" container inspect \
        --format '{{index .Config.Labels "dev.glo.postgres.workspace"}}' \
        "$container_name" 2>/dev/null)"
    [[ "$owner" == "true" && "$owner_workspace" == "$workspace" ]] \
        || fail "Container ${container_name} is not owned by this Glo workspace"
}

container_start() {
    "$container_engine" image inspect "$container_image" >/dev/null 2>&1 \
        || fail "Container image ${container_image} is unavailable; rebuild it with POSTGRES_ENABLED=1"
    mkdir -p "$postgres_root"
    chmod 700 "$postgres_root"
    mounted_root="$(cd "$postgres_root" && pwd -P)"
    if container_exists; then
        require_owned_container
        if container_is_running; then
            container_postgres_is_ready \
                || fail "Containerized PostgreSQL 18 is still starting or unhealthy"
            printf 'PostgreSQL 18 ready at %s\n' "$(database_url)"
            return
        fi
        "$container_engine" container rm "$container_name" >/dev/null
    fi
    "$container_engine" run \
        --detach \
        --name "$container_name" \
        --label dev.glo.postgres=true \
        --label "dev.glo.postgres.workspace=${workspace}" \
        --publish "127.0.0.1:${postgres_port}:${postgres_port}" \
        --mount "type=bind,source=${mounted_root},target=${container_state_root}" \
        --mount "type=bind,source=${helper_path},target=/usr/local/bin/glo-postgres,readonly" \
        --env "GLO_POSTGRES_PORT=${postgres_port}" \
        --env "GLO_POSTGRES_ROOT=${container_state_root}" \
        --env GLO_POSTGRES_LISTEN_HOST=0.0.0.0 \
        --env GLO_POSTGRES_HOST_CIDR=0.0.0.0/0 \
        --user "$(id -u):$(id -g)" \
        "$container_image" \
        bash -ceu '/usr/local/bin/glo-postgres start; exec sleep infinity' >/dev/null
    for _attempt in {1..120}; do
        if container_postgres_is_ready; then
            printf 'PostgreSQL 18 ready at %s\n' "$(database_url)"
            return
        fi
        sleep 0.25
    done
    "$container_engine" logs "$container_name" >&2 || true
    "$container_engine" container rm --force "$container_name" >/dev/null 2>&1 || true
    fail "Containerized PostgreSQL 18 did not become ready"
}

container_stop() {
    if ! container_exists; then
        printf 'PostgreSQL 18 is not running\n'
        return
    fi
    require_owned_container
    if container_is_running; then
        "$container_engine" exec "$container_name" /usr/local/bin/glo-postgres stop
    fi
    "$container_engine" container rm --force "$container_name" >/dev/null
}

container_status() {
    if ! container_exists; then
        fail "PostgreSQL 18 is not running"
    fi
    require_owned_container
    if ! container_postgres_is_ready; then
        fail "PostgreSQL 18 is not running"
    fi
    printf 'PostgreSQL 18 is running at %s\n' "$(database_url)"
}

validate_config

if ((container_mode)); then
    configure_container
    case "$command_name" in
        start) container_start ;;
        stop) container_stop ;;
        status) container_status ;;
        url) database_url ;;
        env) printf 'export GLO_POSTGRES_URL=%q\n' "$(database_url)" ;;
        *) usage >&2; exit 2 ;;
    esac
    exit
fi

require_feature
case "$command_name" in
    run) run_cluster ;;
    start) start_cluster ;;
    stop) stop_cluster ;;
    status)
        if ! is_running; then
            fail "PostgreSQL 18 is not running"
        fi
        printf 'PostgreSQL 18 is running at %s\n' "$(database_url)"
        ;;
    url) database_url ;;
    env) printf 'export GLO_POSTGRES_URL=%q\n' "$(database_url)" ;;
    *) usage >&2; exit 2 ;;
esac
