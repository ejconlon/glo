#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: glo-opencode-serve [--detach] [--workspace PATH]

Start opencode serve in the glo devcontainer and print the Docker-published
host port as OPENCODE_HOST_PORT=<port>.

Options:
  --detach          Keep the devcontainer lifecycle running in the background.
  --workspace PATH  Workspace containing .devcontainer/devcontainer.json.
EOF
}

detach=false
workspace=${GLO_WORKSPACE:-$PWD}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --detach)
            detach=true
            shift
            ;;
        --workspace)
            workspace=${2:?--workspace requires a path}
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

workspace=$(realpath "$workspace")
project=$(basename "$workspace")
devcontainer_json="$workspace/.devcontainer/devcontainer.json"

if [[ ! -f "$devcontainer_json" ]]; then
    echo "Missing devcontainer config: $devcontainer_json" >&2
    exit 1
fi

container_port=$(jq -r '
    (.portsAttributes // {})
    | to_entries[]
    | select(.value.label == "opencode")
    | .key
' "$devcontainer_json" | head -n1)

if [[ -z "$container_port" || "$container_port" == "null" ]]; then
    echo "No portsAttributes entry labeled \"opencode\" in $devcontainer_json" >&2
    exit 1
fi

script_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
glo_root=$(realpath "$script_dir/../../../../..")
glo_justfile="$glo_root/devcontainer/justfile"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/glo"
mkdir -p "$state_dir"
log_file="$state_dir/opencode-serve-$project.log"

container_id() {
    docker ps \
        --filter "label=devcontainer.project=$project" \
        --filter "label=devcontainer.name=opencode" \
        --format '{{.ID}}' \
        | head -n1
}

host_port() {
    local cid=$1
    docker port "$cid" "$container_port/tcp" 2>/dev/null \
        | head -n1 \
        | awk -F: '{ print $NF }'
}

existing_cid=$(container_id)
if [[ -n "$existing_cid" ]]; then
    existing_port=$(host_port "$existing_cid")
    if [[ -n "$existing_port" ]]; then
        echo "OPENCODE_HOST_PORT=$existing_port"
        exit 0
    fi
fi

cmd=(
    just
    -f "$glo_justfile"
    --set workspace "$workspace"
    opencode
    serve
    --port "$container_port"
    --hostname 0.0.0.0
)

if [[ "$detach" == true ]]; then
    nohup "${cmd[@]}" >"$log_file" 2>&1 &
    serve_pid=$!
else
    "${cmd[@]}" >"$log_file" 2>&1 &
    serve_pid=$!
fi

for _ in {1..120}; do
    cid=$(container_id)
    if [[ -n "$cid" ]]; then
        port=$(host_port "$cid")
        if [[ -n "$port" ]]; then
            echo "OPENCODE_HOST_PORT=$port"
            if [[ "$detach" == true ]]; then
                exit 0
            fi
            wait "$serve_pid"
            exit $?
        fi
    fi

    if ! kill -0 "$serve_pid" 2>/dev/null; then
        echo "opencode serve exited before Docker published port $container_port; see $log_file" >&2
        exit 1
    fi

    sleep 0.25
done

echo "Timed out waiting for Docker to publish opencode port $container_port; see $log_file" >&2
exit 1
