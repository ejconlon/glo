#!/usr/bin/env bash
set -euo pipefail

# ticket - minimal ticket system with dependency tracking
# MIT License - vendored from https://github.com/wedow/ticket

_find_workspace() {
    local d="$PWD"
    while [[ "$d" != "/" ]]; do
        [[ -d "$d/.git" ]] && { echo "$d"; return 0; }
        d="$(dirname "$d")"
    done
    echo "[E] No .git directory found from $PWD upward" >&2
    return 1
}
WORKSPACE_DIR="$(_find_workspace)"
_GLO_BIN_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=../lib/paths.sh
source "${_GLO_BIN_DIR}/../lib/paths.sh"
BASE_DIR="$(glo_base_dir "$WORKSPACE_DIR")"

: "${TICKETS_DIR:=${BASE_DIR}/issue}"
[[ -d "$TICKETS_DIR" ]] || { echo "[E] Issue directory not found: $TICKETS_DIR - run bootstrap.sh first" >&2; exit 1; }

# Portable sha256 (Linux: sha256sum, macOS: shasum -a 256)
if command -v sha256sum &>/dev/null; then
    _sha256() { sha256sum; }
else
    _sha256() { shasum -a 256; }
fi

# Portable ISO date (GNU date supports -Iseconds, BSD date does not)
_iso_date() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

# Generate ticket ID from title slug + short hash
generate_id() {
    local title="${1:-untitled}"

    # Convert to lowercase, replace non-alphanumeric with hyphens, collapse multiple hyphens
    local slug
    slug=$(echo "$title" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9]/-/g' | sed 's/-\+/-/g' | sed 's/^-//;s/-$//')

    # Truncate slug to 30 chars max
    slug="${slug:0:30}"
    slug="${slug%-}"  # Remove trailing hyphen if truncation created one

    # Fallback if empty
    [[ -z "$slug" ]] && slug="untitled"

    # 4-char hash from timestamp + PID + nanoseconds for uniqueness
    local hash
    hash=$(echo "$$$(date +%s%N)" | _sha256 | head -c 4)

    echo "${slug}-${hash}"
}

# Ensure tickets directory exists
ensure_dir() {
    mkdir -p "$TICKETS_DIR"
}

# Emit existing issue paths, NUL-delimited, without descending into other folders.
ticket_files() {
    local file directory
    for directory in "$TICKETS_DIR" "$TICKETS_DIR/archive"; do
        for file in "$directory"/*.md; do
            [[ -f "$file" ]] || continue
            case "${file##*/}" in TITLES.md|TAGS.md) continue ;; esac
            printf '%s\0' "$file"
        done
    done
}

# Get a unique ticket path in either location, preferring exact to partial IDs.
ticket_path() {
    local id="$1"
    local exact="$TICKETS_DIR/${id}.md"
    local archived_exact="$TICKETS_DIR/archive/${id}.md"

    if [[ -f "$exact" && -f "$archived_exact" ]]; then
        echo "Error: duplicate ID '$id' exists in both active and archived issues" >&2
        return 1
    elif [[ -f "$exact" ]]; then
        echo "$exact"
        return 0
    fi
    if [[ -f "$archived_exact" ]]; then
        echo "$archived_exact"
        return 0
    fi

    # Try partial match in active and archived issues (anywhere in filename).
    local file name
    local -a matches=()
    while IFS= read -r -d '' file; do
        name="${file##*/}"
        [[ "${name%.md}" == *"$id"* ]] && matches+=("$file")
    done < <(ticket_files)

    if [[ ${#matches[@]} -eq 1 ]]; then
        echo "${matches[0]}"
        return 0
    elif [[ ${#matches[@]} -gt 1 ]]; then
        echo "Error: ambiguous ID '$id' matches multiple tickets" >&2
        return 1
    else
        echo "Error: ticket '$id' not found" >&2
        return 1
    fi
}

# Extract a field only from the leading frontmatter, never from body examples.
yaml_field() {
    GLO_ISSUE_FIELD="$2" awk '
        FNR == 1 { if ($0 != "---") exit; next }
        /^---$/ { exit }
        {
            colon = index($0, ":")
            if (substr($0, 1, colon - 1) == ENVIRON["GLO_ISSUE_FIELD"]) {
                value = substr($0, colon + 1)
                sub(/^[ \t]+/, "", value)
                print value
                found = 1
                exit
            }
        }
        END { if (!found) exit 1 }
    ' "$1"
}

# Validate the flat attribute assignments shared by issue mutations.
validate_attribute_assignment() {
    local expression="$1"
    if [[ ! "$expression" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*= || "$expression" == *$'\n'* || "$expression" == *$'\r'* ]]; then
        echo "Error: invalid attribute assignment '$expression'; expected key=value on one line" >&2
        return 1
    fi
}

# Update fields together, preserving the rest of the document and file mode.
update_yaml_fields() {
    local file="$1"
    shift
    local expression
    local -x GLO_ISSUE_UPDATES=""
    for expression in "$@"; do
        validate_attribute_assignment "$expression" || return 1
        GLO_ISSUE_UPDATES+="${GLO_ISSUE_UPDATES:+$'\n'}$expression"
    done

    local tmp
    tmp=$(mktemp "${file}.tmp.XXXXXX") || return 1
    # Read the document as one record so the body, including its final newline
    # or lack of one, survives exactly. Environment values are never awk code.
    if cp -p -- "$file" "$tmp" && awk '
        BEGIN {
            RS="\0"
            n = split(ENVIRON["GLO_ISSUE_UPDATES"], assignments, "\n")
            for (i = 1; i <= n; i++) {
                at = index(assignments[i], "=")
                key = substr(assignments[i], 1, at - 1)
                if (!(key in updates)) order[++count] = key
                updates[key] = substr(assignments[i], at + 1)
            }
        }
        {
            n = split($0, lines, "\n")
            closing = 0
            if (lines[1] == "---") {
                for (i = 2; i <= n; i++) {
                    if (lines[i] == "---") { closing = i; break }
                }
            }
            if (NR != 1 || !closing) {
                print "Error: issue must have a complete leading frontmatter block" > "/dev/stderr"
                exit 1
            }
            printf "---\n"
            for (i = 2; i < closing; i++) {
                key = substr(lines[i], 1, index(lines[i], ":") - 1)
                if (key in updates) {
                    if (!(key in written)) write_field(key)
                } else printf "%s\n", lines[i]
            }
            for (i = 1; i <= count; i++) {
                key = order[i]
                if (!(key in written)) write_field(key)
            }
            printf "---"
            for (i = closing + 1; i <= n; i++) printf "\n%s", lines[i]
        }
        END {
            if (NR == 0) {
                print "Error: issue is empty" > "/dev/stderr"
                exit 1
            }
        }
        function write_field(key) {
            printf "%s:%s%s\n", key, (updates[key] == "" ? "" : " "), updates[key]
            written[key] = 1
        }
    ' "$file" > "$tmp" && mv -- "$tmp" "$file"; then
        return 0
    fi
    rm -f -- "$tmp"
    return 1
}

# Existing lifecycle and relationship commands use the same literal writer.
update_yaml_field() {
    update_yaml_fields "$1" "$2=$3"
}

cmd_create() {
    ensure_dir

    local title="" description="" design="" acceptance=""
    local priority=2 issue_type="task" assignee="" external_ref="" parent="" tags=""

    # Default assignee to AGENT_NAME env var if set, otherwise empty
    assignee="${AGENT_NAME:-}"

    # Parse args
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -d|--description) description="$2"; shift 2 ;;
            --design) design="$2"; shift 2 ;;
            --acceptance) acceptance="$2"; shift 2 ;;
            -p|--priority) priority="$2"; shift 2 ;;
            -t|--type) issue_type="$2"; shift 2 ;;
            -a|--assignee) assignee="$2"; shift 2 ;;
            --external-ref) external_ref="$2"; shift 2 ;;
            --parent) parent="$2"; shift 2 ;;
            --tags) tags="$2"; shift 2 ;;
            -*) echo "Unknown option: $1" >&2; return 1 ;;
            *) title="$1"; shift ;;
        esac
    done

    title="${title:-Untitled}"
    local id
    id=$(generate_id "$title")
    local file="$TICKETS_DIR/${id}.md"
    local now
    now=$(_iso_date)

    {
        echo "---"
        echo "id: $id"
        echo "status: open"
        echo "deps: []"
        echo "links: []"
        echo "created: $now"
        echo "type: $issue_type"
        echo "priority: $priority"
        if [[ -n "$assignee" ]]; then
            echo "assignee: $assignee"
        else
            echo "assignee:"
        fi
        [[ -n "$external_ref" ]] && echo "external-ref: $external_ref"
        [[ -n "$parent" ]] && echo "parent: $parent"
        if [[ -n "$tags" ]]; then
            echo "tags: [${tags//,/, }]"
        fi
        echo "---"
        echo "# $title"
        echo ""
        if [[ -n "$description" ]]; then
            echo "$description"
            echo ""
        fi
        if [[ -n "$design" ]]; then
            echo "## Design"
            echo ""
            echo "$design"
            echo ""
        fi
        if [[ -n "$acceptance" ]]; then
            echo "## Acceptance Criteria"
            echo ""
            echo "$acceptance"
            echo ""
        fi
    } > "$file"

    echo "$id"
}

# Valid statuses
VALID_STATUSES="open in_progress icebox closed"

validate_status() {
    local status="$1"
    for valid in $VALID_STATUSES; do
        [[ "$status" == "$valid" ]] && return 0
    done
    echo "Error: invalid status '$status'. Must be one of: $VALID_STATUSES" >&2
    return 1
}

cmd_status() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: $(basename "$0") status <id> <status>" >&2
        echo "Valid statuses: $VALID_STATUSES" >&2
        return 1
    fi

    local id="$1"
    local status="$2"

    validate_status "$status" || return 1

    local file
    file=$(ticket_path "$id") || return 1

    cmd_set "$id" "status=$status" >/dev/null || return 1
    echo "Updated $(basename "$file" .md) -> $status"
}

cmd_start() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") start <id>" >&2
        return 1
    fi
    cmd_status "$1" "in_progress"
}

cmd_close() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") close <id>" >&2
        return 1
    fi
    cmd_status "$1" "closed"
}

cmd_icebox() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") icebox <id>" >&2
        return 1
    fi
    cmd_status "$1" "icebox"
}

cmd_reopen() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") reopen <id>" >&2
        return 1
    fi
    cmd_status "$1" "open"
}

# Move storage location without changing status or overwriting another issue.
cmd_archive_location() {
    local action="$1"
    shift
    if [[ $# -ne 1 ]]; then
        echo "Usage: $(basename "$0") $action <id>" >&2
        return 1
    fi
    local file destination status
    file=$(ticket_path "$1") || return 1
    if [[ "$action" == "archive" ]]; then
        status=$(yaml_field "$file" status)
        if [[ "$status" != "closed" && "$status" != "icebox" ]]; then
            echo "Error: only closed or iceboxed issues can be archived; close or icebox the issue first" >&2
            return 1
        fi
        destination="$TICKETS_DIR/archive/$(basename "$file")"
    else
        destination="$TICKETS_DIR/$(basename "$file")"
    fi
    if [[ "$destination" == "$file" ]]; then
        echo "Issue is already in the requested location: $(basename "$file" .md)"
        return 0
    fi
    if [[ -e "$destination" ]]; then
        echo "Error: destination already exists: $destination" >&2
        return 1
    fi
    mkdir -p -- "$(dirname "$destination")"
    mv -n -- "$file" "$destination" || return 1
    if [[ -e "$file" ]]; then
        echo "Error: issue was not moved; destination already exists: $destination" >&2
        return 1
    fi
    echo "${action}: $(basename "$destination" .md)"
}

cmd_dep_tree() {
    local full_mode=0
    local root_id=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full_mode=1; shift ;;
            *) root_id="$1"; shift ;;
        esac
    done

    if [[ -z "$root_id" ]]; then
        echo "Usage: ticket dep tree [--full] <id>" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$root_id") || return 1
    root_id=$(basename "$file" .md)
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)

    awk -v root="$root_id" -v full_mode="$full_mode" '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            deps_str[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
            }
        }
    }

    END {
        if (prev_file) store()
        if (!(root in statuses)) {
            print "Error: ticket " root " has no issue metadata" > "/dev/stderr"
            exit 1
        }

        # Find max depths using iterative approach with stack
        stack[1] = root; stack_depth[1] = 0; stack_path[1] = ":"
        sp = 1
        while (sp > 0) {
            id = stack[sp]; depth = stack_depth[sp]; path = stack_path[sp]
            sp--

            if (!(id in statuses)) continue
            if (index(path, ":" id ":") > 0) continue

            if (!(id in max_depth) || depth > max_depth[id]) {
                max_depth[id] = depth
            }

            new_path = path id ":"
            for (i = dep_count[id]; i >= 1; i--) {
                child = dep_list[id, i]
                if (child != "") {
                    sp++
                    stack[sp] = child
                    stack_depth[sp] = depth + 1
                    stack_path[sp] = new_path
                }
            }
        }

        # Compute subtree depths (iterative post-order)
        delete stack; delete stack_depth; delete stack_path
        delete visited
        stack[1] = root; stack_path[1] = ":"; stack_phase[1] = 0
        sp = 1
        while (sp > 0) {
            id = stack[sp]; path = stack_path[sp]; phase = stack_phase[sp]

            if (!(id in statuses) || index(path, ":" id ":") > 0) { sp--; continue }

            if (phase == 0) {
                # First visit: push children
                stack_phase[sp] = 1
                new_path = path id ":"
                for (i = dep_count[id]; i >= 1; i--) {
                    child = dep_list[id, i]
                    if (child != "" && !(child in subtree_depth)) {
                        sp++
                        stack[sp] = child
                        stack_path[sp] = new_path
                        stack_phase[sp] = 0
                    }
                }
            } else {
                # Second visit: compute subtree depth
                max_sub = max_depth[id]
                for (i = 1; i <= dep_count[id]; i++) {
                    child = dep_list[id, i]
                    if (child in subtree_depth && subtree_depth[child] > max_sub) {
                        max_sub = subtree_depth[child]
                    }
                }
                subtree_depth[id] = max_sub
                sp--
            }
        }

        # Print tree (iterative with stack)
        print root " [" statuses[root] "] " titles[root]
        printed[root] = 1

        delete stack
        # Stack entries: id|depth|prefix|connector|path
        # Start with root children
        build_children(root, 0, "", "", ":" root ":")

        while (print_sp > 0) {
            id = print_stack_id[print_sp]
            depth = print_stack_depth[print_sp]
            prefix = print_stack_prefix[print_sp]
            connector = print_stack_conn[print_sp]
            path = print_stack_path[print_sp]
            print_sp--

            if (!(id in statuses)) continue
            if (!full_mode && (id in printed)) continue
            if (index(path, ":" id ":") > 0) continue
            if (!full_mode && depth != max_depth[id]) continue

            print prefix connector id " [" statuses[id] "] " titles[id]
            if (!full_mode) printed[id] = 1

            if (connector == "└── ") new_prefix = prefix "    "
            else new_prefix = prefix "│   "

            build_children(id, depth, new_prefix, connector, path id ":")
        }
    }

    function build_children(id, depth, prefix, connector, path,    i, child, n, arr, sorted, j, tmp, min_idx) {
        # Collect printable children
        n = 0
        for (i = 1; i <= dep_count[id]; i++) {
            child = dep_list[id, i]
            if (child == "") continue
            if (!full_mode && (child in printed)) continue
            if (!(child in max_depth)) continue
            if (!full_mode && depth + 1 != max_depth[child]) continue
            if (index(path, ":" child ":") > 0) continue
            n++
            arr[n] = child
        }
        if (n == 0) return

        # Sort by subtree_depth, then by ticket ID (insertion sort)
        for (i = 2; i <= n; i++) {
            tmp = arr[i]
            j = i - 1
            while (j >= 1 && (subtree_depth[arr[j]] > subtree_depth[tmp] || \
                   (subtree_depth[arr[j]] == subtree_depth[tmp] && arr[j] > tmp))) {
                arr[j + 1] = arr[j]
                j--
            }
            arr[j + 1] = tmp
        }

        # Push to stack in reverse order (so first prints first)
        for (i = n; i >= 1; i--) {
            child = arr[i]
            print_sp++
            print_stack_id[print_sp] = child
            print_stack_depth[print_sp] = depth + 1
            print_stack_prefix[print_sp] = prefix
            if (i == n) print_stack_conn[print_sp] = "└── "
            else print_stack_conn[print_sp] = "├── "
            print_stack_path[print_sp] = path
        }
    }
    ' "${files[@]}"
}

cmd_dep_cycle() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0
    local file
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)
    if [[ ${#files[@]} -eq 0 ]]; then
        echo "No dependency cycles found"
        return 0
    fi

    awk '
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function store() {
        if (id != "" && status != "closed") {
            statuses[id] = status
            titles[id] = title
            deps_str[id] = deps
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) if (arr[i] != "") {
                dep_count[id]++
                dep_list[id, dep_count[id]] = arr[i]
            }
        }
    }

    # DFS cycle detection
    function dfs(node, path, path_len,    i, child, result) {
        if (!(node in statuses)) return ""
        if (state[node] == 2) return ""  # black - fully visited
        if (state[node] == 1) {
            # gray - found cycle, extract it
            cycle = node
            for (i = path_len; i >= 1; i--) {
                cycle = path[i] " -> " cycle
                if (path[i] == node) break
            }
            return cycle
        }

        state[node] = 1  # gray - visiting
        path[path_len + 1] = node

        for (i = 1; i <= dep_count[node]; i++) {
            child = dep_list[node, i]
            result = dfs(child, path, path_len + 1)
            if (result != "") return result
        }

        state[node] = 2  # black - done
        return ""
    }

    END {
        if (prev_file) store()

        cycle_count = 0
        for (id in statuses) {
            if (state[id] == 0) {
                delete path
                result = dfs(id, path, 0)
                if (result != "") {
                    # Check if this cycle is already found (normalized)
                    # Extract cycle members
                    n = split(result, parts, " -> ")
                    # Normalize: find smallest ID as starting point
                    min_id = parts[1]
                    min_idx = 1
                    for (i = 2; i < n; i++) {  # skip last (duplicate of first)
                        if (parts[i] < min_id) {
                            min_id = parts[i]
                            min_idx = i
                        }
                    }
                    # Build normalized cycle string
                    norm = ""
                    for (i = 0; i < n - 1; i++) {
                        idx = ((min_idx - 1 + i) % (n - 1)) + 1
                        norm = (norm == "") ? parts[idx] : norm "," parts[idx]
                    }
                    # Check if already seen
                    if (!(norm in seen_cycles)) {
                        seen_cycles[norm] = 1
                        cycle_count++
                        cycles[cycle_count] = result
                        cycle_members[cycle_count] = norm
                    }
                }
            }
        }

        if (cycle_count == 0) {
            print "No dependency cycles found"
        } else {
            for (c = 1; c <= cycle_count; c++) {
                if (c > 1) print ""
                print "Cycle " c ": " cycles[c]
                n = split(cycle_members[c], members, ",")
                for (i = 1; i <= n; i++) {
                    id = members[i]
                    printf "  %-35s [%s] %s\n", id, statuses[id], titles[id]
                }
            }
        }
    }
    ' "${files[@]}"
}

cmd_dep() {
    # Handle subcommands
    if [[ "${1:-}" == "tree" ]]; then
        shift
        cmd_dep_tree "$@"
        return
    fi
    if [[ "${1:-}" == "cycle" ]]; then
        shift
        cmd_dep_cycle "$@"
        return
    fi

    if [[ $# -lt 2 ]]; then
        echo "Usage: ticket dep <id> <dependency-id>" >&2
        echo "       ticket dep tree <id>  - show dependency tree" >&2
        echo "       ticket dep cycle      - find dependency cycles" >&2
        return 1
    fi

    local id="$1"
    local dep_id="$2"
    local file dep_file
    file=$(ticket_path "$id") || return 1

    # Store the full ID so relationships survive partial-ID input and archival.
    dep_file=$(ticket_path "$dep_id") || return 1
    dep_id=$(basename "$dep_file" .md)

    # Get current deps
    local current_deps
    current_deps=$(yaml_field "$file" "deps" || true)

    # Add dep if not already present
    if relation_contains "$current_deps" "$dep_id"; then
        echo "Dependency already exists"
        return 0
    fi

    # Update deps array
    update_yaml_field "$file" "deps" "$(relation_update "$current_deps" "$dep_id" add)" || return 1

    echo "Added dependency: $(basename "$file" .md) -> $dep_id"
}

# Extract shared attribute and archive filters before command-specific options. Values go
# through the environment, never through awk source or escape-processing -v.
cmd_filtered_list() {
    local command="$1"
    shift
    local -a arguments=()
    local expression
    local -x GLO_ISSUE_FILTERS=""
    local -x GLO_ISSUE_ARCHIVE_SCOPE="active"
    local -x GLO_ISSUE_ARCHIVE_DIR="$TICKETS_DIR/archive/"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --with-archived|--only-archived)
                local scope="all"
                [[ "$1" == "--only-archived" ]] && scope="archived"
                if [[ "$GLO_ISSUE_ARCHIVE_SCOPE" != "active" && "$GLO_ISSUE_ARCHIVE_SCOPE" != "$scope" ]]; then
                    echo "Error: --with-archived and --only-archived cannot be combined" >&2
                    return 1
                fi
                GLO_ISSUE_ARCHIVE_SCOPE="$scope"
                shift
                continue
                ;;
            -f|--filter)
                if [[ $# -lt 2 ]]; then
                    echo "Error: $1 requires key=value" >&2
                    return 1
                fi
                expression="$2"
                shift 2
                ;;
            --filter=*) expression="${1#--filter=}"; shift ;;
            *) arguments+=("$1"); shift; continue ;;
        esac
        if [[ ! "$expression" =~ ^[a-zA-Z_][a-zA-Z0-9_-]*= || "$expression" == *$'\n'* || "$expression" == *$'\r'* ]]; then
            echo "Error: invalid filter '$expression'; expected key=value on one line" >&2
            return 1
        fi
        GLO_ISSUE_FILTERS+="${GLO_ISSUE_FILTERS:+$'\n'}$expression"
    done

    # Each listing awk program appends its own rendering rules. Index fields by
    # filename so emitting the previous record and retaining all dependency
    # statuses cannot be affected by the next record or by candidate filters.
    local filter_awk
    filter_awk=$(cat <<'AWK'
    BEGIN { filter_count = split(ENVIRON["GLO_ISSUE_FILTERS"], filters, "\n") }
    FNR == 1 { filter_front = ($0 == "---") }
    FNR > 1 && /^---$/ { filter_front = 0 }
    filter_front && FNR > 1 && /^[a-zA-Z_][a-zA-Z0-9_-]*:/ {
        filter_colon = index($0, ":")
        filter_key = substr($0, 1, filter_colon - 1)
        filter_fields[FILENAME, filter_key] = filter_trim(substr($0, filter_colon + 1))
    }
    function filter_trim(value) {
        sub(/^[ \t]+/, "", value)
        sub(/[ \t\r]+$/, "", value)
        return value
    }
    function filter_matches(file,    i, at, key, expected, value, n, j, items, found, archived, scope) {
        archived = (index(file, ENVIRON["GLO_ISSUE_ARCHIVE_DIR"]) == 1)
        scope = ENVIRON["GLO_ISSUE_ARCHIVE_SCOPE"]
        if (scope == "active" && archived) return 0
        if (scope == "archived" && !archived) return 0
        for (i = 1; i <= filter_count; i++) {
            at = index(filters[i], "=")
            key = substr(filters[i], 1, at - 1)
            expected = substr(filters[i], at + 1)
            if (!((file SUBSEP key) in filter_fields)) return 0
            value = filter_fields[file, key]
            if (value ~ /^\[.*\]$/) {
                n = split(substr(value, 2, length(value) - 2), items, ",")
                found = 0
                for (j = 1; j <= n; j++) {
                    value = filter_trim(items[j])
                    if (value != "" && ("x" value) == ("x" expected)) found = 1
                }
                if (!found) return 0
            } else if (("x" value) != ("x" expected)) return 0
        }
        return 1
    }
AWK
)
    "cmd_$command" "${arguments[@]}"
}

cmd_ls() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0

    local status_filter="" assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status=*) status_filter="${1#--status=}"; shift ;;
            -a) assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) echo "Error: unexpected argument '$1'" >&2; return 1 ;;
        esac
    done

    local file
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)
    [[ ${#files[@]} -gt 0 ]] || return 0

    awk -v status_filter="$status_filter" -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" "$filter_awk"'
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; deps=""; assignee=""; tags=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    END { if (prev_file) emit() }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function emit() {
        if (id != "" && filter_matches(prev_file) && (status_filter == "" || status == status_filter) && (assignee_filter == "" || assignee == assignee_filter) && (tag_filter == "" || has_tag(tags, tag_filter))) {
            deps_display = (deps != "") ? "[" deps "]" : "[]"
            gsub(/,/, ", ", deps_display)
            dep_str = (deps_display != "[]") ? " <- " deps_display : ""
            printf "%-35s [%s] - %s%s\n", id, status, title, dep_str
        }
    }
    ' "${files[@]}"
}

cmd_ready() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0

    local assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a) assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) echo "Error: unexpected argument '$1'" >&2; return 1 ;;
        esac
    done

    local file
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)
    [[ ${#files[@]} -gt 0 ]] || return 0

    awk -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" "$filter_awk"'
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; priority=""; assignee=""; tags=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function store() {
        if (id != "") {
            matches[id] = filter_matches(prev_file)
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            priorities[id] = (priority != "") ? priority : 2
            assignees[id] = assignee
            all_tags[id] = tags
        }
    }
    END {
        if (prev_file) store()
        # Find ready tickets: active with all deps closed
        for (id in statuses) {
            if (!matches[id]) continue
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue
            if (assignee_filter != "" && assignees[id] != assignee_filter) continue
            if (tag_filter != "" && !has_tag(all_tags[id], tag_filter)) continue

            deps = deps_raw[id]
            ready = 1
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep != "" && statuses[dep] != "closed") {
                        ready = 0
                        break
                    }
                }
            }
            if (ready) {
                output[++count] = sprintf("%s|%s|%s|%s", priorities[id], id, statuses[id], titles[id])
            }
        }

        # Sort by priority, then by id
        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, "|")
                split(output[j], b, "|")
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], f, "|")
            printf "%-35s [P%s][%s] - %s\n", f[2], f[1], f[3], f[4]
        }
    }
    ' "${files[@]}"
}

cmd_closed() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0

    local limit=20 assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --limit=*) limit="${1#--limit=}"; shift ;;
            -a) assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) echo "Error: unexpected argument '$1'" >&2; return 1 ;;
        esac
    done

    if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
        echo "Error: --limit requires a nonnegative integer" >&2
        return 1
    fi

    # List all files by mtime, then filter before applying the result limit.
    local file
    local -a candidates=() files=()
    while IFS= read -r -d '' file; do candidates+=("$file"); done < <(ticket_files)
    [[ ${#candidates[@]} -gt 0 ]] || return 0
    while IFS= read -r -d '' file; do
        files+=("$file")
    done < <(find "${candidates[@]}" -maxdepth 0 -printf '%T@\t%p\0' | sort -z -t$'\t' -k1,1rn | cut -z -f2)
    awk -v limit="$limit" -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" "$filter_awk"'
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        id=""; status=""; title=""; assignee=""; tags=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function emit() {
        if (id != "" && filter_matches(prev_file) && (status == "closed" || status == "done") && (assignee_filter == "" || assignee == assignee_filter) && (tag_filter == "" || has_tag(tags, tag_filter))) {
            output[++count] = sprintf("%-35s [%s] - %s", id, status, title)
        }
    }
    END {
        if (prev_file) emit()
        for (i = 1; i <= count && i <= limit; i++) print output[i]
    }
    ' "${files[@]}"
}

cmd_blocked() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0

    local assignee_filter="" tag_filter=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            -a) assignee_filter="$2"; shift 2 ;;
            --assignee=*) assignee_filter="${1#--assignee=}"; shift ;;
            -T) tag_filter="$2"; shift 2 ;;
            --tag=*) tag_filter="${1#--tag=}"; shift ;;
            *) echo "Error: unexpected argument '$1'" >&2; return 1 ;;
        esac
    done

    local file
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)
    [[ ${#files[@]} -gt 0 ]] || return 0

    awk -v assignee_filter="$assignee_filter" -v tag_filter="$tag_filter" "$filter_awk"'
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; priority=""; assignee=""; tags=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^priority:/ { priority = $2 }
    in_front && /^assignee:/ { assignee = $2 }
    in_front && /^tags:/ { tags = $2; gsub(/[\[\] ]/, "", tags) }
    in_front && /^deps:/ {
        deps = $2
        gsub(/[\[\] ]/, "", deps)
    }
    !in_front && /^# / && title == "" { title = substr($0, 3) }
    function has_tag(tags_str, tag,    i, n, arr) {
        n = split(tags_str, arr, ",")
        for (i = 1; i <= n; i++) if (arr[i] == tag) return 1
        return 0
    }
    function store() {
        if (id != "") {
            matches[id] = filter_matches(prev_file)
            statuses[id] = status
            titles[id] = title
            deps_raw[id] = deps
            priorities[id] = (priority != "") ? priority : 2
            assignees[id] = assignee
            all_tags[id] = tags
        }
    }
    END {
        if (prev_file) store()
        # Find blocked tickets: active with at least one dep not closed
        for (id in statuses) {
            if (!matches[id]) continue
            status = statuses[id]
            if (status != "open" && status != "in_progress") continue
            if (assignee_filter != "" && assignees[id] != assignee_filter) continue
            if (tag_filter != "" && !has_tag(all_tags[id], tag_filter)) continue

            deps = deps_raw[id]
            if (deps == "") continue

            blocked = 0
            n = split(deps, arr, ",")
            for (i = 1; i <= n; i++) {
                dep = arr[i]
                if (dep != "" && statuses[dep] != "closed") {
                    blocked = 1
                    break
                }
            }
            if (blocked) {
                # Build list of only open blockers
                blockers = ""
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    dep = arr[i]
                    if (dep != "" && statuses[dep] != "closed") {
                        blockers = (blockers == "") ? dep : blockers ", " dep
                    }
                }
                output[++count] = sprintf("%s|%s|%s|%s|[%s]", priorities[id], id, status, titles[id], blockers)
            }
        }

        # Sort by priority, then by id
        for (i = 1; i <= count; i++) {
            for (j = i + 1; j <= count; j++) {
                split(output[i], a, "|")
                split(output[j], b, "|")
                if (a[1] > b[1] || (a[1] == b[1] && a[2] > b[2])) {
                    tmp = output[i]; output[i] = output[j]; output[j] = tmp
                }
            }
        }

        for (i = 1; i <= count; i++) {
            split(output[i], f, "|")
            printf "%-35s [P%s][%s] - %s <- %s\n", f[2], f[1], f[3], f[4], f[5]
        }
    }
    ' "${files[@]}"
}

# Parse the issue format's inline ID lists without substring or regex matching.
relation_members() {
    local value="${1#\[}" member
    value="${value%\]}"
    local -a members=()
    IFS=',' read -r -a members <<< "$value"
    for member in "${members[@]}"; do
        member="${member#"${member%%[![:space:]]*}"}"
        member="${member%"${member##*[![:space:]]}"}"
        [[ -n "$member" ]] && printf '%s\n' "$member"
    done
    return 0
}

# Test a whole relationship ID, including when another ID contains it.
relation_contains() {
    local member
    while IFS= read -r member; do
        [[ "$member" == "$2" ]] && return 0
    done < <(relation_members "$1")
    return 1
}

# Render a list after adding or removing one full ID, preserving other members.
relation_update() {
    local value="$1" target="$2" action="$3" member result="" found=false
    while IFS= read -r member; do
        if [[ "$member" == "$target" ]]; then
            found=true
            [[ "$action" == "remove" ]] && continue
        fi
        result+="${result:+, }$member"
    done < <(relation_members "$value")
    if [[ "$action" == "add" && "$found" == false ]]; then
        result+="${result:+, }$target"
    fi
    printf '[%s]\n' "$result"
}

cmd_undep() {
    if [[ $# -ne 2 ]]; then
        echo "Usage: glo-issue undep <id> <dependency-id>" >&2
        return 1
    fi
    local file dep_file dep_id="$2" current_deps
    file=$(ticket_path "$1") || return 1
    current_deps=$(yaml_field "$file" deps || true)
    # An exact stored ID can be removed even if the target file is missing.
    if ! relation_contains "$current_deps" "$dep_id"; then
        dep_file=$(ticket_path "$dep_id") || return 1
        dep_id=$(basename "$dep_file" .md)
    fi
    if ! relation_contains "$current_deps" "$dep_id"; then
        echo "Dependency not found" >&2
        return 1
    fi
    update_yaml_field "$file" deps "$(relation_update "$current_deps" "$dep_id" remove)" || return 1
    echo "Removed dependency: $(basename "$file" .md) -/-> $dep_id"
}

cmd_link() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: glo-issue link <id> <id> [id...]" >&2
        return 1
    fi
    # Resolve every endpoint before changing any file, including archive paths.
    local -a ids=() files=()
    local arg file self target current_links updated i count=0
    for arg in "$@"; do
        file=$(ticket_path "$arg") || return 1
        ids+=("$(basename "$file" .md)")
        files+=("$file")
    done
    for ((i=0; i<${#ids[@]}; i++)); do
        file="${files[$i]}"
        self="${ids[$i]}"
        current_links=$(yaml_field "$file" links || true)
        updated="${current_links:-[]}"
        for target in "${ids[@]}"; do
            [[ "$target" == "$self" ]] && continue
            if ! relation_contains "$updated" "$target"; then
                updated=$(relation_update "$updated" "$target" add)
                count=$((count + 1))
            fi
        done
        if [[ "$updated" != "${current_links:-[]}" ]]; then
            update_yaml_field "$file" links "$updated" || return 1
        fi
    done
    if [[ $count -eq 0 ]]; then
        echo "All links already exist"
    else
        echo "Added $count link(s) between ${#ids[@]} tickets"
    fi
}

cmd_unlink() {
    if [[ $# -ne 2 ]]; then
        echo "Usage: glo-issue unlink <id> <target-id>" >&2
        return 1
    fi
    local file target_file id target_id current_links target_links
    file=$(ticket_path "$1") || return 1
    target_file=$(ticket_path "$2") || return 1
    id=$(basename "$file" .md)
    target_id=$(basename "$target_file" .md)
    current_links=$(yaml_field "$file" links || true)
    target_links=$(yaml_field "$target_file" links || true)
    if ! relation_contains "$current_links" "$target_id" && ! relation_contains "$target_links" "$id"; then
        echo "Link not found" >&2
        return 1
    fi
    update_yaml_field "$file" links "$(relation_update "$current_links" "$target_id" remove)" || return 1
    update_yaml_field "$target_file" links "$(relation_update "$target_links" "$id" remove)" || return 1
    echo "Removed link: $id <-> $target_id"
}

cmd_show() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ticket show <id>" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    local target_id
    target_id=$(basename "$file" .md)
    local candidate
    local -a files=()
    while IFS= read -r -d '' candidate; do files+=("$candidate"); done < <(ticket_files)

    awk -v target="$target_id" -v target_file="$file" '
    BEGIN { FS=": "; in_front=0 }

    # First pass: collect all ticket metadata
    FNR==1 {
        if (prev_file) store()
        id=""; status=""; title=""; deps=""; links=""; parent=""; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^id:/ { id = $2 }
    in_front && /^status:/ { status = $2 }
    in_front && /^deps:/ { deps = $2; gsub(/[\[\] ]/, "", deps) }
    in_front && /^links:/ { links = $2; gsub(/[\[\] ]/, "", links) }
    in_front && /^parent:/ { parent = $2 }
    !in_front && /^# / && title == "" { title = substr($0, 3) }

    function store() {
        if (id != "") {
            statuses[id] = status
            titles[id] = title
            all_deps[id] = deps
            all_links[id] = links
            parents[id] = parent
        }
    }

    END {
        if (prev_file) store()

        # Build inverse relationships
        for (id in statuses) {
            # Children: tickets where parent == target
            if (parents[id] == target) {
                children_count++
                children[children_count] = id
            }
            # Blocking: tickets where target is in their deps
            deps = all_deps[id]
            if (deps != "") {
                n = split(deps, arr, ",")
                for (i = 1; i <= n; i++) {
                    if (arr[i] == target && statuses[id] != "closed" && statuses[target] != "closed") {
                        blocking_count++
                        blocking[blocking_count] = id
                    }
                }
            }
        }

        # Now output the target file with enhancements
        in_front = 0
        while ((getline line < target_file) > 0) {
            if (line == "---") {
                in_front = !in_front
                print line
            } else if (in_front && line ~ /^parent:/) {
                # Add parent title as comment
                p = line
                sub(/^parent: */, "", p)
                if (p in titles) {
                    print line "  # " titles[p]
                } else {
                    print line
                }
            } else {
                print line
            }
        }
        close(target_file)

        # Collect blockers (unclosed deps)
        deps = all_deps[target]
        if (deps != "") {
            n = split(deps, arr, ",")
            blocker_count = 0
            for (i = 1; i <= n; i++) {
                d = arr[i]
                if (d != "" && statuses[d] != "closed") {
                    blocker_count++
                    blockers[blocker_count] = d
                }
            }
            if (blocker_count > 0) {
                print ""
                print "## Blockers"
                print ""
                for (i = 1; i <= blocker_count; i++) {
                    d = blockers[i]
                    printf "- %s [%s] %s\n", d, statuses[d], titles[d]
                }
            }
        }

        # Show tickets this is blocking
        if (blocking_count > 0) {
            print ""
            print "## Blocking"
            print ""
            for (i = 1; i <= blocking_count; i++) {
                b = blocking[i]
                printf "- %s [%s] %s\n", b, statuses[b], titles[b]
            }
        }

        # Show children
        if (children_count > 0) {
            print ""
            print "## Children"
            print ""
            for (i = 1; i <= children_count; i++) {
                c = children[i]
                printf "- %s [%s] %s\n", c, statuses[c], titles[c]
            }
        }

        # Collect linked tickets
        links = all_links[target]
        if (links != "") {
            n = split(links, arr, ",")
            print ""
            print "## Linked"
            print ""
            for (i = 1; i <= n; i++) {
                l = arr[i]
                if (l != "") {
                    printf "- %s [%s] %s\n", l, statuses[l], titles[l]
                }
            }
        }
    }
    ' "${files[@]}"
}

cmd_add_note() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ticket add-note <id> [note text]" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1
    shift

    local note
    if [[ $# -gt 0 ]]; then
        note="$*"
    elif [[ ! -t 0 ]]; then
        note=$(cat)
    else
        echo "Error: no note provided" >&2
        return 1
    fi

    local timestamp
    timestamp=$(_iso_date)

    # Add Notes section if missing, then append timestamped note
    if ! grep -q '^## Notes' "$file"; then
        printf '\n## Notes\n' >> "$file"
    fi
    printf '\n**%s**\n\n%s\n' "$timestamp" "$note" >> "$file"

    echo "Note added to $(basename "$file" .md)"
}

cmd_edit() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: ticket edit <id>" >&2
        return 1
    fi

    local file
    file=$(ticket_path "$1") || return 1

    if [ -t 0 ] && [ -t 1 ]; then
        "${EDITOR:-vi}" "$file"
    else
        echo "Edit ticket file: $file"
    fi
}

cmd_query() {
    [[ ! -d "$TICKETS_DIR" ]] && return 0

    if [[ $# -gt 1 || "${1:-}" == -* ]]; then
        echo "Usage: glo-issue query [--filter key=value]... [jq-filter]" >&2
        return 1
    fi
    local filter="${1:-}"
    local file
    local -a files=()
    while IFS= read -r -d '' file; do files+=("$file"); done < <(ticket_files)
    [[ ${#files[@]} -gt 0 ]] || return 0

    # Generate all JSON in one awk pass
    local json_output
    json_output=$(awk "$filter_awk"'
    BEGIN { FS=": "; in_front=0 }
    FNR==1 {
        if (prev_file) emit()
        field_count=0; in_front=0
        prev_file=FILENAME
        in_front=($0 == "---")
        next
    }
    /^---$/ { in_front = 0; next }
    in_front && /^[a-zA-Z_][a-zA-Z0-9_-]*:/ {
        colon = index($0, ":")
        key = substr($0, 1, colon - 1)
        val = filter_trim(substr($0, colon + 1))
        field_count++
        field_keys[field_count] = key
        field_vals[field_count] = val
    }
    function json_string(value,    result, i, c) {
        result = "\""
        for (i = 1; i <= length(value); i++) {
            c = substr(value, i, 1)
            if (c == "\\" || c == "\"") result = result "\\" c
            else if (c == "\t") result = result "\\t"
            else if (c == "\r") result = result "\\r"
            else result = result c
        }
        return result "\""
    }
    function emit() {
        if (field_count > 0 && filter_matches(prev_file)) {
            printf "{"
            for (i = 1; i <= field_count; i++) {
                if (i > 1) printf ","
                key = field_keys[i]
                val = field_vals[i]
                # Handle arrays
                if (val ~ /^\[.*\]$/) {
                    gsub(/^\[|\]$/, "", val)
                    n = split(val, items, ", *")
                    printf "%s:[", json_string(key)
                    for (j = 1; j <= n; j++) {
                        if (j > 1) printf ","
                        gsub(/^ +| +$/, "", items[j])
                        if (items[j] != "") printf "%s", json_string(items[j])
                    }
                    printf "]"
                } else {
                    printf "%s:%s", json_string(key), json_string(val)
                }
            }
            printf "}\n"
        }
    }
    END { if (prev_file) emit() }
    ' "${files[@]}")

    [[ -n "$json_output" ]] || return 0
    if [[ -n "$filter" ]]; then
        echo "$json_output" | jq -c "select($filter)"
    else
        echo "$json_output"
    fi
}

# Set ordinary attributes; retain lifecycle behavior and graph invariants.
cmd_set() {
    if [[ $# -lt 2 ]]; then
        echo "Usage: $(basename "$0") set <id> key=value [key=value ...]" >&2
        return 1
    fi
    local id="$1"
    shift
    local expression key value status=""
    for expression in "$@"; do
        validate_attribute_assignment "$expression" || return 1
        key="${expression%%=*}"
        value="${expression#*=}"
        case "$key" in
            id)
                echo "Error: issue IDs cannot be changed" >&2
                return 1
                ;;
            deps|links)
                echo "Error: use dep/undep or link/unlink to change $key" >&2
                return 1
                ;;
            status)
                validate_status "$value" || return 1
                status="$value"
                ;;
        esac
    done

    local file destination
    file=$(ticket_path "$id") || return 1
    destination="$file"
    if [[ "$file" == "$TICKETS_DIR/archive/"* \
        && ( "$status" == "open" || "$status" == "in_progress" ) ]]; then
        destination="$TICKETS_DIR/$(basename "$file")"
        if [[ -e "$destination" ]]; then
            echo "Error: cannot resume archived issue; active file already exists: $destination" >&2
            return 1
        fi
    fi

    update_yaml_fields "$file" "$@" || return 1
    if [[ "$destination" != "$file" ]]; then
        mv -- "$file" "$destination" || return 1
    fi
    printf 'Updated %s:' "$(basename "$destination" .md)"
    printf ' %s' "$@"
    printf '\n'
}

cmd_set_assignee() {
    if [[ $# -lt 1 ]]; then
        echo "Usage: $(basename "$0") set-assignee <id> [name]" >&2
        return 1
    fi

    local id="$1"
    local name="${2:-}"
    local file
    file=$(ticket_path "$id") || return 1
    local ticket_id
    ticket_id=$(basename "$file" .md)

    if [[ -n "$name" ]]; then
        update_yaml_field "$file" "assignee" "$name"
        echo "Set assignee on ${ticket_id} to ${name}"
    else
        local current
        current=$(yaml_field "$file" "assignee")
        if [[ -z "$current" ]]; then
            echo "Error: ticket '${ticket_id}' has no assignee" >&2
            return 1
        fi
        update_yaml_field "$file" "assignee" ""
        echo "Cleared assignee on ${ticket_id} (was ${current})"
    fi
}

cmd_help() {
    local cmd
    cmd=$(basename "$0")
    cat << EOF
$cmd - minimal ticket system with dependency tracking
Run 'glo readme' for full documentation.

Usage: $cmd <command> [arguments] [options]
       $cmd <command> --help

Arguments in angle brackets are required; square brackets mark optional arguments.
Uppercase placeholders such as NAME and TAG must be replaced with a value.

Commands:
  create [title] [options] Create ticket, prints ID
  start <id>               Set status to in_progress
  icebox <id>              Set status to icebox (deferred, incomplete)
  close <id>               Set status to closed
  reopen <id>              Set status to open
  archive <id>             Move a closed/iceboxed issue to archive/
  unarchive <id>           Restore an issue file without changing its status
  status <id> <status>     Update status (open|in_progress|icebox|closed)
  dep <id> <dep-id>        Add dependency (id depends on dep-id)
  dep tree [--full] <id>   Show dependency tree (--full disables dedup)
  dep cycle                Find cycles among non-closed issues in both locations
  undep <id> <dep-id>      Remove dependency
  link <id> <id> [id...]   Link tickets together (symmetric)
  unlink <id> <target-id>  Remove link between tickets
  ls [options]            List tickets, filename order within each location
  ready [options]         List open/in-progress tickets with deps resolved
  blocked [options]       List open/in-progress tickets with unresolved deps
  closed [options]        List recently closed tickets, newest modification first
  show <id>                Display ticket
  set <id> key=value ...  Set one or more frontmatter attributes
  set-assignee <id> [name] Set or clear assignee field
  edit <id>                Open ticket in \$EDITOR
  add-note <id> [text]     Append timestamped note (or pipe via stdin)
  query [options] [jq-filter] Output tickets as JSON, optionally filtered

Create options (values follow the option as a separate argument):
  -d, --description TEXT  Issue description; quote text containing spaces
      --design TEXT      Design notes
      --acceptance TEXT  Acceptance criteria
  -t, --type TYPE         bug|feature|task|epic|chore [default: task]
  -p, --priority N        Priority 0-4, 0=highest [default: 2]
  -a, --assignee NAME     Initial assignee [default: AGENT_NAME, otherwise empty]
      --external-ref REF External reference, e.g. gh-123 or JIRA-456
      --parent ID        Parent issue ID
      --tags TAGS        Comma-separated tags, e.g. ui,backend,urgent

Listing options:
      --with-archived      Include active and archived issues
      --only-archived      Select only archived issues
                          Both apply to ls, ready, blocked, closed and query
                          Default: active directory only; choose at most one
  -a NAME, --assignee=NAME Match the assignee (ls, ready, blocked, closed)
  -T TAG, --tag=TAG        Match one whole tag (ls, ready, blocked, closed)
      --status=STATUS     Match status (ls only; default: all statuses)
                          STATUS: open|in_progress|icebox|closed
      --limit=N           Maximum matching results (closed only; default: 20)
                          N is a nonnegative integer; 0 returns no results
  -f KEY=VALUE             Match any frontmatter attribute
      --filter KEY=VALUE   Same as -f; also accepts --filter=KEY=VALUE
                          Available on ls, ready, blocked, closed and query

Listing options combine with AND. Repeat --filter to require multiple matches.
Use -T for tag filtering; lowercase -t sets the type when creating an issue.
Long listing options for assignee, tag, status and limit require '='.
Empty legacy assignee/tag/status options disable that restriction; use -f
assignee= to select a present empty assignee.

Attribute filter behavior:
  Scalars match exactly; inline lists match a member. Missing keys never match.
  Values are literal, case-sensitive text. KEY= matches a present empty scalar.
  Quote the whole KEY=VALUE for spaces. Filters must fit on one line.
  Example: $cmd ls -f plan=review -f type=epic
  Example: $cmd ready --assignee=agent --tag=peal --filter=priority=1

Positional arguments and other options:
  id, dep-id, target-id   Issue IDs; unambiguous partial IDs also work
  title                  Issue title [default: Untitled]; quote multiple words
  name                   Assignee name; omit it on set-assignee to clear the field
  text                   Note text; add-note also accepts text on standard input
  key=value              Attribute name and its new value; split at the first '='
  jq-filter              jq predicate applied to each JSON issue (query only)
                          Example: $cmd query '.type == "epic"'
  --full                 Show repeated dependency branches (dep tree only)
  -h, --help             Show this reference, including after a command name

Attribute updates:
  $cmd set <id> plan=accept priority=1
  key= leaves an empty value; quote arguments with spaces or inline lists.
  Example: $cmd set <id> 'tags=[peal, syntax]' 'assignee=Jane Doe'
  Status updates use the usual lifecycle; use dep/link commands for relations.
  IDs cannot be changed. All assignments are checked before writing.

Archive behavior:
  ID lookups, relationships, show, dep tree and dep cycle include archive/.
  Dependencies always resolve against both locations, regardless of filters.
  Closed dependencies are satisfied; iceboxed and missing ones are unresolved.
  archive requires status closed or icebox; unarchive preserves status.
  Both moves preserve content and modification time and refuse overwrites.
  start/reopen or setting an active status also restores archived issues.
  glo-notes precommit uses archive/unarchive to reconcile storage with status.
  A still-closed/iceboxed issue will be archived again by that command.
  Example: $cmd closed --with-archived --limit=5
  Example: $cmd query --only-archived -f plan=accept

Environment:
  GLO_BASE     Notebook root [default: base]; relative to the workspace root
               or an absolute path. Empty values also use the default.
  TICKETS_DIR  Override the issue directory for direct glo-issue calls
               [default: the selected notebook root plus /issue]

Tickets are Markdown files under the selected issue directory and its archive/.
Supports partial ID matching (e.g., '$cmd show 5c4' matches 'nw-5c46')
EOF
}

# Command-level help is read-only, including for commands that normally mutate.
if [[ $# -eq 2 && ( "$2" == "--help" || "$2" == "-h" ) ]]; then
    case "$1" in
        create|start|icebox|close|reopen|archive|unarchive|status|dep|undep|link|unlink|ls|ready|blocked|closed|show|set|set-assignee|edit|add-note|query)
            cmd_help
            exit 0
            ;;
    esac
fi

# Main dispatch
case "${1:-help}" in
    create) shift; cmd_create "$@" ;;
    start)  shift; cmd_start "$@" ;;
    icebox) shift; cmd_icebox "$@" ;;
    close)  shift; cmd_close "$@" ;;
    reopen) shift; cmd_reopen "$@" ;;
    archive|unarchive) cmd_archive_location "$@" ;;
    status) shift; cmd_status "$@" ;;
    dep)    shift; cmd_dep "$@" ;;
    undep)  shift; cmd_undep "$@" ;;
    link)   shift; cmd_link "$@" ;;
    unlink) shift; cmd_unlink "$@" ;;
    ls|ready|blocked|closed|query) cmd_filtered_list "$@" ;;
    show)   shift; cmd_show "$@" ;;
    set)    shift; cmd_set "$@" ;;
    set-assignee) shift; cmd_set_assignee "$@" ;;
    edit)   shift; cmd_edit "$@" ;;
    add-note) shift; cmd_add_note "$@" ;;
    help|--help|-h) cmd_help ;;
    *)
        echo "Unknown command: $1" >&2
        cmd_help >&2
        exit 1
        ;;
esac
