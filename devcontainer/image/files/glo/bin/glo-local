#!/usr/bin/env bash
set -euo pipefail

GHC_VERSION="9.12.4"
CABAL_VERSION="3.16.1.0"
STACK_VERSION="3.9.3"
HLS_VERSION="2.14.0.0"
WASM_GHC_FLAVOUR="9.14"
WASM_GHC_META_REF="master"
RUST_VERSION="1.95.0"
CARGO_BINSTALL_VERSION="1.19.1"
CARGO_RUN_BIN_VERSION="1.7.5"
NODE_VERSION="latest LTS"
ROCQ_VERSION="9.0.0"
ROCQ_OCAML_VERSION="5.3.0"
VSROCQ_LANGUAGE_SERVER_PACKAGE="vsrocq-language-server"

DRY_RUN=0
OS=""
ARCH=""
PKG=""
TS_DONE=0

usage() {
    cat <<EOF
glo-local - install local host dependencies for glo workspaces

Usage: glo-local [--dry-run] <command>

Commands:
  all       Install base, py, rs, hs, wasm, rocq, ts, ps, notes
  need      Install all except disabled toolchains; Rocq only installs when ROCQ_ENABLED is enabled
  base      Install common CLI tools
  py        Install Python/uv tooling
  rs        Install Rust ${RUST_VERSION} with rustfmt/clippy/rust-analyzer/rust-src, wasm32 target, cargo-binstall, cargo-run-bin
  hs        Install GHC ${GHC_VERSION}, cabal ${CABAL_VERSION}, stack ${STACK_VERSION}, HLS ${HLS_VERSION}, ormolu, hlint via ghcup
  wasm      Install wasm32-wasi GHC tooling via ghc-wasm-meta (${WASM_GHC_FLAVOUR})
  rocq      Install Rocq ${ROCQ_VERSION}, vsrocqtop, and command-line tools via opam
  ts,node   Install nvm-managed Node.js/npm tooling (${NODE_VERSION})
  ps        Install PureScript tooling
  notes     Install zk/sqlite tooling
  doctor    Print detected OS/arch and tool versions

Supported package managers:
  Arch Linux: pacman
  macOS:      brew
  Other Linux: wasm and doctor only, assuming base tools are already installed
EOF
}

log() { printf '[I] %s\n' "$*" >&2; }
warn() { printf '[W] %s\n' "$*" >&2; }
die() { printf '[E] %s\n' "$*" >&2; exit 1; }

without_nounset() {
    local nounset_was_on=0
    case $- in
        *u*) nounset_was_on=1; set +u ;;
    esac

    "$@"
    local status=$?

    if [[ "$nounset_was_on" -eq 1 ]]; then
        set -u
    fi
    return "$status"
}

run() {
    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '+ '
        printf '%q ' "$@"
        printf '\n'
    else
        "$@"
    fi
}

detect_platform() {
    local command_name="${1:-}"
    ARCH="$(uname -m)"
    case "$(uname -s)" in
        Darwin)
            OS="macos"
            command -v brew >/dev/null 2>&1 || die "Homebrew not found. Install brew first: https://brew.sh"
            PKG="brew"
            ;;
        Linux)
            if [[ -r /etc/arch-release ]]; then
                OS="arch"
                command -v pacman >/dev/null 2>&1 || die "pacman not found on Arch Linux"
                PKG="pacman"
            elif [[ "$command_name" == "wasm" || "$command_name" == "doctor" ]]; then
                OS="linux"
                PKG="none"
            else
                die "Unsupported Linux distribution. glo-local currently supports Arch Linux and macOS."
            fi
            ;;
        *)
            die "Unsupported OS: $(uname -s)"
            ;;
    esac
}

pkg_install() {
    (($# > 0)) || return 0
    case "$PKG" in
        brew)
            run brew install "$@"
            ;;
        pacman)
            if [[ "$EUID" -eq 0 ]]; then
                run pacman -S --needed --noconfirm "$@"
            else
                run sudo pacman -S --needed --noconfirm "$@"
            fi
            ;;
        *)
            die "Package manager not detected"
            ;;
    esac
}

install_base() {
    log "Installing base tools for ${OS}/${ARCH}"
    case "$OS" in
        arch)
            pkg_install base-devel bash coreutils git github-cli jq yq just fd bat ripgrep shellcheck sqlite wget curl unzip zip tar gzip bzip2 xz zstd openssh make pkgconf
            run aura -A devcontainer-cli
            ;;
        macos)
            pkg_install bash coreutils devcontainer git gh jq yq just fd bat ripgrep shellcheck sqlite wget curl unzip zip xz zstd pkgconf
            ;;
    esac
}

install_py() {
    log "Installing Python tooling"
    case "$OS" in
        arch)
            pkg_install python python-pip uv
            ;;
        macos)
            pkg_install python uv
            ;;
    esac
}

ensure_rustup() {
    if command -v rustup >/dev/null 2>&1; then
        return
    fi
    case "$OS" in
        arch)
            pkg_install rustup
            ;;
        macos)
            pkg_install rustup-init
            if ! command -v rustup >/dev/null 2>&1; then
                run rustup-init -y --no-modify-path
                export PATH="$HOME/.cargo/bin:$PATH"
            fi
            ;;
    esac
}

install_rs() {
    log "Installing Rust ${RUST_VERSION}"
    local toolchain_bin
    ensure_rustup
    run rustup toolchain install "$RUST_VERSION" --profile minimal
    run rustup default "$RUST_VERSION"
    run rustup component add rust-analyzer rust-src rustfmt clippy --toolchain "$RUST_VERSION"
    run rustup target add wasm32-unknown-unknown --toolchain "$RUST_VERSION"
    toolchain_bin="$(dirname "$(rustup which --toolchain "$RUST_VERSION" rustc)")"
    export PATH="$toolchain_bin:$PATH"
    run rustup run "$RUST_VERSION" cargo install cargo-binstall --version "$CARGO_BINSTALL_VERSION" --locked
    run rustup run "$RUST_VERSION" cargo install cargo-run-bin --version "$CARGO_RUN_BIN_VERSION" --locked
}

ensure_ghcup() {
    if command -v ghcup >/dev/null 2>&1; then
        return
    fi
    case "$OS" in
        arch)
            pkg_install ghcup-hs
            ;;
        macos)
            pkg_install ghcup
            ;;
    esac
    [[ "$DRY_RUN" -eq 1 ]] && return
    command -v ghcup >/dev/null 2>&1 || die "ghcup was not found after package install. Install ghcup, then rerun 'glo-local hs'."
}

link_latest_ghcup_tool() {
    local tool="$1"
    local target=""
    local dest=""

    if [[ "$OS" == "macos" ]]; then
        dest="/usr/local/bin/${tool}"
        [[ "$ARCH" == "arm64" ]] && dest="/opt/homebrew/bin/${tool}"
    else
        dest="/usr/local/bin/${tool}"
    fi

    target="$(command -v "${tool}" 2>/dev/null || true)"
    if [[ -z "$target" ]]; then
        target="$(compgen -c | grep -E "^${tool}-[0-9]" | sort -V | tail -1 || true)"
    fi
    [[ -n "$target" ]] || return 0
    target="$(command -v "$target")"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        run ln -sf "$target" "$dest"
    elif [[ -w "$(dirname "$dest")" ]]; then
        run ln -sf "$target" "$dest"
    else
        run sudo ln -sf "$target" "$dest"
    fi
}

install_hs() {
    log "Installing Haskell toolchain via ghcup"
    ensure_ghcup
    run ghcup install ghc "$GHC_VERSION" --set
    run ghcup install cabal "$CABAL_VERSION" --set
    run ghcup install stack "$STACK_VERSION" --set
    run ghcup install hls "$HLS_VERSION" --set
    run ghcup config add-release-channel 3rdparty
    run ghcup install ormolu || warn "ormolu install failed; continuing"
    run ghcup install hlint
    link_latest_ghcup_tool ormolu || warn "ormolu link failed; continuing"
    link_latest_ghcup_tool hlint
}

install_wasm() {
    log "Installing wasm32-wasi GHC tooling via ghc-wasm-meta (${WASM_GHC_FLAVOUR})"
    local prefix="${GHC_WASM_PREFIX:-$HOME/.local/opt/ghc-wasm}"
    local tmpdir
    tmpdir="$(mktemp -d)"
    trap 'rm -rf "${tmpdir:-}"' RETURN

    run git clone --depth 1 --branch "$WASM_GHC_META_REF" https://github.com/haskell-wasm/ghc-wasm-meta.git "$tmpdir/ghc-wasm-meta"
    run env FLAVOUR="$WASM_GHC_FLAVOUR" PREFIX="$prefix" bash "$tmpdir/ghc-wasm-meta/setup.sh"
    run mkdir -p "$HOME/.local/bin"
    for tool in \
        wasm32-wasi-cabal \
        wasm32-wasi-ghc \
        wasm32-wasi-ghc-pkg \
        wasm32-wasi-ghci \
        wasm32-wasi-haddock \
        wasm32-wasi-hsc2hs \
        wasmtime \
        wasm-opt; do
        local src=""
        case "$tool" in
            wasm32-wasi-cabal) src="$prefix/wasm32-wasi-cabal/bin/$tool" ;;
            wasm32-wasi-*) src="$prefix/wasm32-wasi-ghc/bin/$tool" ;;
            wasmtime) src="$prefix/wasmtime/bin/$tool" ;;
            wasm-opt) src="$prefix/binaryen/bin/$tool" ;;
        esac
        if [[ -n "$src" ]]; then
            install_wasm_wrapper "$tool" "$src"
        fi
    done

    if [[ "$DRY_RUN" -eq 0 ]]; then
        command -v wasm32-wasi-ghc >/dev/null 2>&1 || warn "Add $HOME/.local/bin to PATH to use wasm32-wasi-ghc"
        warn "For wasm GHCi/JSFFI, export NODE_PATH=$prefix/nodejs/lib/node_modules or source $prefix/env"
    fi
}

install_wasm_wrapper() {
    local tool="$1"
    local src="$2"
    local dest="$HOME/.local/bin/$tool"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        printf '+ install wrapper %q -> %q\n' "$dest" "$src"
        return
    fi

    if [[ ! -x "$src" ]]; then
        warn "wasm tool source is not executable; skipping wrapper: $src"
        rm -f "$dest"
        return
    fi

    local resolved_src lines=()
    resolved_src="$(realpath "$src")"

    mapfile -n 2 -t lines <"$src"
    if [[ "${lines[1]:-}" == "exec $resolved_src \"\$@\"" || "${lines[1]:-}" == "exec $src \"\$@\"" ]]; then
        die "wasm tool source is already a self-recursive wrapper: $src"
    fi

    local tmp
    tmp="$(mktemp "$HOME/.local/bin/.${tool}.XXXXXX")"
    printf '#!/usr/bin/env bash\nexec %q "$@"\n' "$src" >"$tmp"
    mv "$tmp" "$dest"
    chmod 755 "$dest"
}

ensure_opam() {
    if command -v opam >/dev/null 2>&1; then
        return
    fi
    case "$OS" in
        arch)
            pkg_install opam
            ;;
        macos)
            pkg_install opam
            ;;
    esac
    [[ "$DRY_RUN" -eq 1 ]] && return
    command -v opam >/dev/null 2>&1 || die "opam was not found after package install. Install opam, then rerun 'glo-local rocq'."
}

install_rocq() {
    log "Installing Rocq ${ROCQ_VERSION} and ${VSROCQ_LANGUAGE_SERVER_PACKAGE} via opam"
    ensure_opam
    if [[ "$DRY_RUN" -eq 0 && ! -d "${OPAMROOT:-$HOME/.opam}" ]]; then
        run opam init --bare --disable-sandboxing --no-setup --yes
    fi
    if [[ "$DRY_RUN" -eq 1 ]] || ! opam switch list --short | grep -qx rocq; then
        run opam switch create rocq "ocaml-base-compiler.${ROCQ_OCAML_VERSION}" --yes
    fi
    if [[ "$DRY_RUN" -eq 1 ]] || ! opam repo list --short | grep -qx rocq-released; then
        run opam repo add rocq-released https://rocq-prover.org/opam/released --yes
    fi
    run opam update --yes
    run opam install --switch=rocq --yes "rocq-prover.${ROCQ_VERSION}" "${VSROCQ_LANGUAGE_SERVER_PACKAGE}"
    if [[ "$DRY_RUN" -eq 0 ]]; then
        eval "$(opam env --switch=rocq --set-switch)"
        command -v rocq >/dev/null 2>&1 || warn "Run: eval \"\$(opam env --switch=rocq --set-switch)\" to use rocq"
        command -v vsrocqtop >/dev/null 2>&1 || warn "Run: eval \"\$(opam env --switch=rocq --set-switch)\" to use vsrocqtop"
    fi
}

source_nvm() {
    if command -v nvm >/dev/null 2>&1; then
        return 0
    fi

    export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
    local nvm_sh
    for nvm_sh in \
        "$NVM_DIR/nvm.sh" \
        "/usr/local/nvm/nvm.sh" \
        "/opt/homebrew/opt/nvm/nvm.sh" \
        "/usr/local/opt/nvm/nvm.sh" \
        "/usr/share/nvm/init-nvm.sh" \
        "/usr/share/nvm/nvm.sh"; do
        if [[ -s "$nvm_sh" ]]; then
            # shellcheck source=/dev/null
            without_nounset . "$nvm_sh"
            command -v nvm >/dev/null 2>&1 && return 0
        fi
    done

    return 1
}

ensure_nvm() {
    source_nvm && return 0

    case "$OS" in
        arch)
            pkg_install nvm
            ;;
        macos)
            pkg_install nvm
            run mkdir -p "${NVM_DIR:-$HOME/.nvm}"
            ;;
    esac

    [[ "$DRY_RUN" -eq 1 ]] && return 0
    source_nvm || die "nvm was not found after package install. Restart your shell, then rerun 'glo-local ts'."
}

install_ts() {
    [[ "$TS_DONE" -eq 1 ]] && return
    log "Installing TypeScript/Node tooling via nvm (${NODE_VERSION})"
    ensure_nvm
    without_nounset run nvm install --lts
    without_nounset run nvm alias default 'lts/*'
    without_nounset run nvm use --lts
    TS_DONE=1
}

install_ps() {
    install_ts
    log "Installing PureScript tooling"
    local prefix="${NPM_CONFIG_PREFIX:-$HOME/.local}"
    run mkdir -p "$prefix"
    run npm install --global --prefix "$prefix" purescript spago purs-tidy
    case ":$PATH:" in
        *":$prefix/bin:"*) ;;
        *) warn "Add $prefix/bin to PATH to use purs, spago, and purs-tidy" ;;
    esac
}

install_notes() {
    log "Installing notes tooling"
    case "$OS" in
        arch)
            pkg_install zk sqlite
            ;;
        macos)
            pkg_install zk sqlite
            ;;
    esac
}

find_workspace() {
    local d="$PWD"
    while [[ "$d" != "/" ]]; do
        if [[ -d "$d/.devcontainer" ]]; then
            printf '%s\n' "$d"
            return 0
        fi
        d="$(dirname "$d")"
    done
    printf '%s\n' "$PWD"
}

devcontainer_arg_disabled() {
    local flag="$1"
    local workspace="$2"
    local file
    shopt -s nullglob
    for file in "$workspace"/.devcontainer/*.json "$workspace"/.devcontainer/*.jsonc; do
        if grep -Eiq '"'"$flag"'"[[:space:]]*:[[:space:]]*"?(0|false|no|off)"?' "$file"; then
            shopt -u nullglob
            return 0
        fi
    done
    shopt -u nullglob
    return 1
}

devcontainer_arg_enabled() {
    local flag="$1"
    local workspace="$2"
    local file
    shopt -s nullglob
    for file in "$workspace"/.devcontainer/*.json "$workspace"/.devcontainer/*.jsonc; do
        if grep -Eiq '"'"$flag"'"[[:space:]]*:[[:space:]]*"?(1|true|yes|on)"?' "$file"; then
            shopt -u nullglob
            return 0
        fi
    done
    shopt -u nullglob
    return 1
}

install_need() {
    local workspace
    workspace="$(find_workspace)"

    install_base
    install_py

    if devcontainer_arg_disabled RUST_ENABLED "$workspace"; then
        log "Skipping Rust toolchain; RUST_ENABLED is disabled"
    else
        install_rs
    fi

    if devcontainer_arg_disabled HASKELL_ENABLED "$workspace"; then
        log "Skipping Haskell toolchain; HASKELL_ENABLED is disabled"
    else
        install_hs
    fi

    if devcontainer_arg_disabled WASM_GHC_ENABLED "$workspace"; then
        log "Skipping wasm32-wasi GHC toolchain; WASM_GHC_ENABLED is disabled"
    else
        install_wasm
    fi

    if devcontainer_arg_enabled ROCQ_ENABLED "$workspace"; then
        install_rocq
    else
        log "Skipping Rocq toolchain; ROCQ_ENABLED is disabled"
    fi

    install_ts

    if devcontainer_arg_disabled PURESCRIPT_ENABLED "$workspace"; then
        log "Skipping PureScript tooling; PURESCRIPT_ENABLED is disabled"
    else
        install_ps
    fi

    install_notes
}

doctor() {
    printf 'OS:   %s\n' "$OS"
    printf 'Arch: %s\n' "$ARCH"
    printf 'Pkg:  %s\n' "$PKG"
    source_nvm >/dev/null 2>&1 || true
    for tool in git gh devcontainer just fd bat rg shellcheck jq yq sqlite3 sha256sum uv python3 rustup rustc cargo cargo-binstall cargo-bin ghcup ghc cabal stack haskell-language-server-wrapper ormolu hlint wasm32-wasi-ghc wasm32-wasi-cabal wasm32-wasi-ghc-pkg wasm32-wasi-hsc2hs wasmtime wasm-opt opam rocq rocqchk vsrocqtop nvm node npm purs spago purs-tidy zk; do
        if command -v "$tool" >/dev/null 2>&1; then
            printf '%-32s %s\n' "$tool" "$(command -v "$tool")"
        else
            printf '%-32s %s\n' "$tool" "(missing)"
        fi
    done
}

main() {
    while (($# > 0)); do
        case "$1" in
            --dry-run)
                DRY_RUN=1
                shift
                ;;
            help|--help|-h)
                usage
                exit 0
                ;;
            *)
                break
                ;;
        esac
    done

    detect_platform "${1:-help}"

    case "${1:-help}" in
        all)
            install_base
            install_py
            install_rs
            install_hs
            install_wasm
            install_rocq
            install_ts
            install_ps
            install_notes
            ;;
        need) install_need ;;
        base) install_base ;;
        py) install_py ;;
        rs) install_rs ;;
        hs) install_hs ;;
        wasm) install_wasm ;;
        rocq) install_rocq ;;
        ts|node) install_ts ;;
        ps) install_ps ;;
        notes) install_notes ;;
        doctor) doctor ;;
        help|--help|-h) usage ;;
        *)
            usage >&2
            die "Unknown command: $1"
            ;;
    esac
}

main "$@"
