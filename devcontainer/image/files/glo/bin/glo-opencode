#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: glo-opencode <command> [options]

Commands:
  serve [--detach] [--workspace PATH]
      Start opencode serve in the glo devcontainer and print the
      Docker-published host port as OPENCODE_HOST_PORT=<port>.

  connect [--workspace PATH] [--container ID]
      Attach the local opencode TUI to the workspace's devcontainer server.
      Reuses an existing healthy server and continues the most recently
      updated root session when possible. --container attaches to a specific
      container.

  list [--workspace PATH] [--all]
      List opencode devcontainers and their published ports.

  roots [--workspace PATH]
      Print OPENCODE_HOST_WORKSPACE and OPENCODE_CONTAINER_WORKSPACE.

  kill [--workspace PATH] [--all] [--container ID]
      Stop opencode devcontainers. Defaults to the current workspace project;
      --all stops all opencode devcontainers. --container stops one container.
EOF
}

command=${1:-}
if [[ -z "$command" || "$command" == "--help" || "$command" == "-h" ]]; then
    usage
    exit 0
fi
shift

detach=false
all=false
container=
workspace=${GLO_WORKSPACE:-$PWD}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --detach)
            detach=true
            shift
            ;;
        --all)
            all=true
            shift
            ;;
        --container)
            container=${2:?--container requires a container ID}
            shift 2
            ;;
        --workspace)
            workspace=${2:?--workspace requires a path}
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            echo "Unknown argument: $1" >&2
            usage >&2
            exit 2
            ;;
    esac
done

workspace=$(realpath "$workspace")
project=$(basename "$workspace")
devcontainer_json="$workspace/.devcontainer/devcontainer.json"

if [[ ! -f "$devcontainer_json" ]]; then
    echo "Missing devcontainer config: $devcontainer_json" >&2
    exit 1
fi

container_port=$(jq -r '
    (.portsAttributes // {})
    | to_entries[]
    | select(.value.label == "opencode")
    | .key
' "$devcontainer_json" | head -n1)

if [[ -z "$container_port" || "$container_port" == "null" ]]; then
    echo "No portsAttributes entry labeled \"opencode\" in $devcontainer_json" >&2
    exit 1
fi

container_workspace=$(jq -r --arg project "$project" '
    .remoteWorkspaceFolder // "/workspaces/\($project)"
' "$devcontainer_json")

script_dir=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
glo_root=$(realpath "$script_dir/../../../../..")
glo_justfile="$glo_root/devcontainer/justfile"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/glo"
mkdir -p "$state_dir"
log_file="$state_dir/opencode-serve-$project.log"

container_ids() {
    local filters=(--filter "label=devcontainer.name=opencode")
    if [[ "$all" != true ]]; then
        filters+=(--filter "label=devcontainer.project=$project")
    fi
    docker ps "${filters[@]}" --format '{{.ID}}'
}

all_container_ids() {
    docker ps --filter "label=devcontainer.name=opencode" --format '{{.ID}}'
}

host_port() {
    local cid=$1
    docker port "$cid" "$container_port/tcp" 2>/dev/null \
        | head -n1 \
        | awk -F: '{ print $NF }'
}

server_healthy() {
    local port=$1
    curl -fsS --connect-timeout 0.5 --max-time 1 \
        "http://127.0.0.1:${port}/global/health" >/dev/null 2>&1
}

urlencode() {
    jq -rn --arg value "$1" '$value | @uri'
}

healthy_server() {
    local cid port
    while IFS= read -r cid; do
        [[ -n "$cid" ]] || continue
        port=$(host_port "$cid")
        if [[ -n "$port" ]] && server_healthy "$port"; then
            printf '%s\t%s\n' "$cid" "$port"
            return 0
        fi
    done < <(container_ids)
    return 1
}

single_healthy_server() {
    local cid port found= count=0
    while IFS= read -r cid; do
        [[ -n "$cid" ]] || continue
        port=$(host_port "$cid")
        if [[ -n "$port" ]] && server_healthy "$port"; then
            found=$(printf '%s\t%s' "$cid" "$port")
            count=$((count + 1))
        fi
    done < <(all_container_ids)

    if [[ "$count" -eq 1 ]]; then
        printf '%s\n' "$found"
        return 0
    fi
    return 1
}

serve() {
    local cid port serve_pid
    local before_file
    before_file=$(mktemp)
    container_ids >"$before_file"

    local cmd=(
        just
        -f "$glo_justfile"
        --set workspace "$workspace"
        opencode
        serve
        --port "$container_port"
        --hostname 0.0.0.0
    )

    if [[ "$detach" == true ]]; then
        nohup "${cmd[@]}" >"$log_file" 2>&1 &
        serve_pid=$!
    else
        "${cmd[@]}" >"$log_file" 2>&1 &
        serve_pid=$!
    fi

    for _ in {1..120}; do
        cid=$(container_ids | while IFS= read -r candidate; do
            if [[ -n "$candidate" ]] && ! grep -qxF "$candidate" "$before_file"; then
                printf '%s\n' "$candidate"
                break
            fi
        done)
        if [[ -n "$cid" ]]; then
            port=$(host_port "$cid")
            if [[ -n "$port" ]] && server_healthy "$port"; then
                echo "OPENCODE_HOST_PORT=$port"
                echo "OPENCODE_CONTAINER_ID=$cid"
                rm -f "$before_file"
                if [[ "$detach" == true ]]; then
                    return 0
                fi
                wait "$serve_pid"
                return $?
            fi
        fi

        if ! kill -0 "$serve_pid" 2>/dev/null; then
            echo "opencode serve exited before Docker published port $container_port; see $log_file" >&2
            rm -f "$before_file"
            return 1
        fi

        sleep 0.25
    done

    echo "Timed out waiting for Docker to publish opencode port $container_port; see $log_file" >&2
    rm -f "$before_file"
    return 1
}

list() {
    local cid port
    printf 'CONTAINER\tPROJECT\tHOST_PORT\n'
    while IFS= read -r cid; do
        [[ -n "$cid" ]] || continue
        port=$(host_port "$cid")
        printf '%s\t%s\t%s\n' \
            "$cid" \
            "$(docker inspect -f '{{ index .Config.Labels "devcontainer.project" }}' "$cid")" \
            "${port:-}"
    done < <(container_ids)
}

connect() {
    local server cid port session_id encoded_dir sessions_json
    if [[ -n "$container" ]]; then
        cid=$container
        port=$(host_port "$cid")
        if [[ -z "$port" ]]; then
            echo "Container $cid does not publish opencode port $container_port" >&2
            return 1
        fi
        if ! server_healthy "$port"; then
            echo "Container $cid is not serving opencode on host port $port" >&2
            return 1
        fi
    elif server=$(healthy_server); then
        cid=${server%%$'\t'*}
        port=${server##*$'\t'}
    elif server=$(single_healthy_server); then
        cid=${server%%$'\t'*}
        port=${server##*$'\t'}
    else
        echo "No healthy opencode server found." >&2
        return 1
    fi

    if [[ -z "${port:-}" ]]; then
        echo "Could not determine opencode host port" >&2
        return 1
    fi

    encoded_dir=$(urlencode "$container_workspace")
    sessions_json=$(curl -fsS "http://127.0.0.1:${port}/session?directory=${encoded_dir}" 2>/dev/null || true)
    if [[ -n "$sessions_json" ]]; then
        session_id=$(jq -r '
            def updated: .time.updated // 0;
            (map(select(.parentID == null)) | sort_by(updated) | last // empty).id
            // (sort_by(updated) | last // empty).id
            // empty
        ' <<<"$sessions_json")
    fi

    export OPENCODE_CONTAINER_ID=${cid:-}
    if [[ -n "$session_id" ]]; then
        exec opencode attach "http://127.0.0.1:${port}" --dir "$container_workspace" --session "$session_id"
    fi
    exec opencode attach "http://127.0.0.1:${port}" --dir "$container_workspace"
}

roots() {
    echo "OPENCODE_HOST_WORKSPACE=$workspace"
    echo "OPENCODE_CONTAINER_WORKSPACE=$container_workspace"
}

kill_containers() {
    local ids
    if [[ -n "$container" ]]; then
        docker rm -f "$container" >/dev/null
        return 0
    fi

    ids=$(container_ids)
    if [[ -z "$ids" ]]; then
        return 0
    fi
    docker rm -f $ids >/dev/null
}

case "$command" in
    serve) serve ;;
    connect) connect ;;
    list) list ;;
    roots) roots ;;
    kill) kill_containers ;;
    *)
        echo "Unknown command: $command" >&2
        usage >&2
        exit 2
        ;;
esac
